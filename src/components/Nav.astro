---
export interface Props {
  active?: 'writing' | 'marginalia' | 'trails' | 'projects' | 'books' | 'now';
}

const { active } = Astro.props;
const links = [
  { key: 'writing', href: '/writing/', label: 'Writing' },
  { key: 'marginalia', href: '/marginalia/', label: 'Notes' },
  { key: 'projects', href: '/projects/', label: 'Projects' },
  { key: 'books', href: '/books/', label: 'Books' },
  { key: 'trails', href: '/trails/', label: 'Trails' },
  { key: 'now', href: '/now/', label: 'Now' },
];
---

<header class="site-head">
  <a href="/" class="brand">Bhuvan</a>
  <nav class="site-nav" aria-label="Main">
    {links.map((l) => (
      <a href={l.href} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
</header>
