---
// Direction B running head + colophon.
import Shell from './Shell.astro';
import { GITHUB, TWITTER } from '../../utils/lab';
interface Props { title: string; active?: string }
const { title, active } = Astro.props;
const nav = [['Writing', '/lab/b/essay/'], ['Notes', '/lab/b/notes/'], ['Projects', '/lab/b/projects/'], ['Books', '/books/'], ['Now', '/lab/b/#now']];
---
<Shell title={title} dir="b" fonts="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400..700;1,400..700&family=Alegreya+SC:wght@400;500&display=swap">
  <header class="run">
    <a class="home sc" href="/lab/b/">Bhuvan</a>
    <nav>{nav.map(([l, h]) => <a class="sc" href={h} aria-current={l === active ? 'page' : undefined}>{l}</a>)}</nav>
  </header>
  <slot />
  <footer class="colophon">
    <span class="fleuron">❦</span>
    Set in Alegreya, a typeface made for literature by Huerta Tipográfica. Written in Bangalore, built with Astro, served without cookies or scripts.
    <nav><a class="sc" href={GITHUB}>GitHub</a><a class="sc" href={TWITTER}>Twitter</a><a class="sc" href="/rss.xml">RSS</a></nav>
  </footer>
</Shell>
