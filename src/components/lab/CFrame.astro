---
// Direction C header + footer on the 12-column grid.
import Shell from './Shell.astro';
import { GITHUB, TWITTER } from '../../utils/lab';
interface Props { title: string; active?: string }
const { title, active } = Astro.props;
const nav = [['Writing', '/lab/c/essay/'], ['Notes', '/lab/c/notes/'], ['Projects', '/lab/c/projects/'], ['Books', '/books/'], ['Now', '/lab/c/#now']];
---
<Shell title={title} dir="c" fonts="https://fonts.googleapis.com/css2?family=Host+Grotesk:ital,wght@0,300..800;1,300..800&display=swap">
  <header class="g head">
    <a class="name" href="/lab/c/">Bhuvan</a>
    <nav>{nav.map(([l, h]) => <a href={h} aria-current={l === active ? 'page' : undefined}>{l}</a>)}</nav>
  </header>
  <slot />
  <footer class="g foot">
    <div>Bhuvan<br /><span class="lbl">Bangalore, India</span></div>
    <div><a href={GITHUB}>GitHub</a><br /><a href={TWITTER}>Twitter</a></div>
    <div><a href="/rss.xml">Essays RSS</a><br /><a href="/updates-rss.xml">Notes RSS</a></div>
    <div class="lbl">Set in Host Grotesk by Element Type. No cookies, no scripts.</div>
  </footer>
</Shell>
