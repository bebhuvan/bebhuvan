---
// Direction D header + footer: C's grid and grotesk apparatus around A's serif pages.
import Shell from './Shell.astro';
import { today, fmtLong, GITHUB, TWITTER } from '../../utils/lab';
interface Props { title: string; active?: string }
const { title, active } = Astro.props;
const nav = [['Writing', '/lab/d/essay/'], ['Notes', '/lab/d/notes/'], ['Projects', '/lab/d/projects/'], ['Books', '/books/'], ['Now', '/lab/d/#now']];
const day = today.toLocaleDateString('en-GB', { weekday: 'long' });
---
<Shell title={title} dir="d" fonts="https://fonts.googleapis.com/css2?family=Host+Grotesk:ital,wght@0,300..800;1,300..800&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,300..500&display=swap">
  <header class="g head">
    <a class="name" href="/lab/d/">Bhuvan<i>.</i></a>
    <span class="lbl when">Bangalore · {day}, {fmtLong(today)}</span>
    <nav>{nav.map(([l, h]) => <a href={h} aria-current={l === active ? 'page' : undefined}>{l}</a>)}</nav>
  </header>
  <slot />
  <footer class="g foot">
    <div class="me"><img src="/profile-pic-160.webp" alt="" width="44" height="44" /><span>Doer of random things, diver of weird rabbit holes.</span></div>
    <div><a href={GITHUB}>GitHub</a><br /><a href={TWITTER}>Twitter</a></div>
    <div><a href="/rss.xml">Essays RSS</a><br /><a href="/updates-rss.xml">Notes RSS</a></div>
    <div class="lbl">Set in Host Grotesk and Source Serif. No cookies, no scripts.</div>
  </footer>
</Shell>
