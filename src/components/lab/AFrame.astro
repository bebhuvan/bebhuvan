---
// Direction A masthead + footer around a page.
import Shell from './Shell.astro';
import { today, fmtLong, GITHUB, TWITTER } from '../../utils/lab';
interface Props { title: string; active?: string }
const { title, active } = Astro.props;
const nav = [['Writing', '/lab/a/essay/'], ['Notes', '/lab/a/notes/'], ['Projects', '/lab/a/projects/'], ['Books', '/books/'], ['Now', '/lab/a/#now']];
const day = today.toLocaleDateString('en-GB', { weekday: 'long' });
---
<Shell title={title} dir="a" fonts="https://fonts.googleapis.com/css2?family=Libre+Bodoni:ital,wght@0,400..700;1,400..700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,300..500&family=Hanken+Grotesk:wght@400..700&display=swap">
  <header class="wrap mast">
    <div class="mast-row">
      <a class="brand" href="/lab/a/">Bhuvan<i>.</i></a>
      <nav class="nav">{nav.map(([l, h]) => <a href={h} aria-current={l === active ? 'page' : undefined}>{l}</a>)}</nav>
    </div>
    <div class="dateline cap"><span>Bangalore · {day}, {fmtLong(today)}</span><span>Essays, notes and small websites</span></div>
  </header>
  <slot />
  <footer class="wrap foot">
    <img src="/profile-pic-160.webp" alt="" width="52" height="52" />
    <p>Doer of random things, diver of weird rabbit holes.</p>
    <nav><a href={GITHUB}>GitHub</a><a href={TWITTER}>Twitter</a><a href="/rss.xml">RSS</a></nav>
  </footer>
</Shell>
