---
export interface Props {
  meta?: string;
  hand?: string;
}

const {
  meta = 'Zerodha &middot; Bangalore &middot; The Internet<br>A small corner on the dumpster fire since 2019',
  hand = "You read all the way to the footer? That's more commitment than most of my drafts get."
} = Astro.props;
---

<footer class="site-foot">
  <div class="site-foot-inner">
    <p class="foot-line">{hand}</p>
    <div class="foot-meta">
      <p set:html={meta} />
      <p><a href="/rss.xml">RSS</a> &middot; <a href="/updates-rss.xml">Notes RSS</a> &middot; <a href="https://twitter.com/bhuvanesh2007">Twitter</a></p>
    </div>
  </div>
</footer>
