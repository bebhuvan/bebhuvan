---
import { getCollection } from 'astro:content';
import { smart } from '../utils/typo';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.status !== 'archived')
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// The sentence and the margin are both grouped by `kind`. `lead` opens that
// clause of the sentence; `label` heads the group in the margin.
const kinds = [
  { key: 'library', lead: 'Rooms for old words:', label: 'Rooms for old words' },
  { key: 'numbers', lead: 'Ways to read India and the world in numbers:', label: 'In numbers' },
  { key: 'reading', lead: 'Places to keep what I read:', label: 'What I read' },
  { key: 'street', lead: 'And one for the street:', label: 'The street' },
  { key: 'other', lead: 'And', label: 'Elsewhere' },
];
const groups = kinds
  .map((k) => ({ ...k, items: projects.filter((p) => (p.data.kind ?? 'other') === k.key) }))
  .filter((g) => g.items.length);
const num = new Map(groups.flatMap((g) => g.items).map((p, i) => [p.id, i + 1]));

const id = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const join = (i: number, n: number) => (i < n - 2 ? ', ' : i === n - 2 ? ' and ' : '. ');
---

<Layout title="Projects — Bhuvan" description="Things I build — mostly for myself, occasionally useful to others.">
  <Nav active="projects" />

  <main class="split">
    <div class="statement">
      <h1 class="statement-text">
        Things I build, mostly for myself, occasionally useful to others.
        {groups.map((g) => (
          <>{g.lead}{' '}{g.items.map((p, i) => (
            <><span class="nm">{smart(p.data.title)}<a class="r" href={`#${id(p.data.title)}`}>{num.get(p.id)}</a></span>{join(i, g.items.length)}</>
          ))}</>
        ))}
      </h1>
      <p class="statement-sub">Every project is really an excuse to learn something.</p>
    </div>

    <div class="margin">
      {groups.map((g) => (
        <>
          <h2 class="group-h">{g.label}<span>{g.items.length}</span></h2>
          {g.items.map(async (project) => {
            const { Content } = await project.render();
            return (
              <section class="ann proj" id={id(project.data.title)}>
                <h3 class="proj-name"><span class="n">{num.get(project.id)}</span><a class="hl" href={project.data.link || '#'}>{smart(project.data.title)}</a></h3>
                <p class="desc">{smart(project.data.description)}</p>
                <div class="prose story"><Content /></div>
                {project.data.story && <p class="aside">{project.data.story}</p>}
                {project.data.link && <a class="more" href={project.data.link}>{project.data.url || 'Visit'}</a>}
              </section>
            );
          })}
        </>
      ))}
    </div>
  </main>

  <Footer
    meta={`Zerodha &middot; Bangalore &middot; The Internet<br>${projects.length} projects and counting. All of them started as &ldquo;just a weekend thing.&rdquo;`}
    hand="The best projects are the ones that were never supposed to be projects."
  />
</Layout>

<style>
  .nm { white-space: nowrap; }
  .group-h { padding-bottom: 10px; border-bottom: 1px solid var(--rule); }
  .group-h ~ .group-h { margin-top: 88px; }
  .proj { margin-top: 40px; }
  .group-h + .proj { margin-top: 28px; }
  .proj-name { display: flex; align-items: baseline; gap: 12px; font-family: var(--serif); font-weight: 300; font-size: 1.85rem; line-height: 1.15; letter-spacing: -.01em; }
  /* the number is set like the margin numbers on the home page, at the name's size */
  .proj-name .n { font-weight: 300; color: var(--flame); min-width: 1.25em; }
  .proj-name a { color: var(--ink); }
  .proj-name a:hover { background-size: 100% var(--marker-h); }
  /* text hangs from the name, past the number (1.25em of the name's size, plus the gap) */
  .desc, .story, .proj .aside, .proj .more { margin-left: calc(1.25 * 1.85rem + 12px); }
  .desc { margin-top: 10px; font-family: var(--serif); font-size: 1.14rem; line-height: 1.5; max-width: 36em; text-wrap: pretty; }
  .story { margin-top: 8px; }
  .story :global(p) { font-size: 1rem; line-height: 1.6; color: var(--ink-soft); }
  .proj .aside { margin-top: 12px; }
  .proj .more { display: block; width: fit-content; }
  @media (max-width: 600px) {
    .proj-name { font-size: 1.55rem; }
    .desc, .story, .proj .aside, .proj .more { margin-left: 0; }
    .desc { font-size: 1.08rem; }
  }
</style>
