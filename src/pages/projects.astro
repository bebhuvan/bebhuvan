---
// Projects: the featured ones as spreads with a picture, then every project by group.
import Base from '../layouts/Base.astro';
import Invite from '../components/Invite.astro';
import { SITE, projects, projectKinds, smart, srcset } from '../utils/site';
const featured = projects.filter((p) => p.data.featured && p.data.image);
const list = { '@type': 'CollectionPage', '@id': `${SITE.url}/projects/#collection`, name: 'Projects', mainEntity: { '@type': 'ItemList', itemListElement: projects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'WebSite', name: smart(p.data.title), url: p.data.link, description: smart(p.data.description) } })) } };
---
<Base title="Projects" description={`${projects.length} small websites by Bhuvan: old letters and books set to be read, Indian data explained, a record of Bengaluru’s footpaths and more.`} active="Projects" schema={[list]} crumbs={[['Projects', '/projects/']]}>
  <header class="g phead">
    <span class="lbl ink">Projects · {projects.length}</span>
    <div class="tt">
      <h1>Small websites, built on evenings and weekends. <span>Each one started as an itch.</span></h1>
      <p>Old letters set to be read, Indian data explained, a commonplace book and a record of Bengaluru’s broken footpaths. If one of them is your itch too, <a href="#collaborate">come and help</a>.</p>
    </div>
  </header>
  {featured.map((p) => (
    <article class="g spread">
      <a class="frame" href={p.data.link} tabindex="-1" aria-hidden="true"><img src={p.data.image} srcset={srcset(p.data.image)} sizes="(max-width: 860px) 100vw, 760px" alt="" width="1280" height="800" loading="lazy" decoding="async" /></a>
      <div class="txt">
        <span class="lbl"><span class="sq"></span>{projectKinds.find((k) => k.key === p.data.kind)?.label}</span>
        <h2><a href={p.data.link}>{smart(p.data.title)}</a></h2>
        <p class="desc">{smart(p.data.description)}</p>
        {p.data.story && <p class="why">“{smart(p.data.story)}”</p>}
        <a class="url" href={p.data.link}>{p.data.url} ↗</a>
      </div>
    </article>
  ))}
  {projectKinds.map((k, i) => {
    const ps = projects.filter((p) => p.data.kind === k.key);
    return ps.length > 0 && (
      <section class="g group" aria-labelledby={`k-${k.key}`}>
        <div class="gl"><h2 id={`k-${k.key}`}><b><span class="num">0{i + 1}</span>{k.label}</b></h2><span class="dek">{k.blurb}</span></div>
        <div class="gt">
          {ps.map((p) => (
            <div class="prow">
              <h3><a href={p.data.link}>{smart(p.data.title)}</a></h3>
              <p class="desc">{smart(p.data.description)}</p>
              <a class="url" href={p.data.link}>{p.data.url} ↗</a>
            </div>
          ))}
        </div>
      </section>
    );
  })}
  <Invite />
</Base>
