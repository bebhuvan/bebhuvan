---
import { getCollection } from 'astro:content';
import { smart } from '../utils/typo';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const updates = (await getCollection('updates'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const updatesByMonth = updates.reduce((acc, update) => {
  const key = update.data.publishDate.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
  (acc[key] ||= []).push(update);
  return acc;
}, {} as Record<string, typeof updates>);
const months = Object.keys(updatesByMonth);
---

<Layout title="Notes — Bhuvan" description="Notes in the margins — thoughts, observations, and loose threads.">
  <Nav active="marginalia" />

  <main class="split">
    <div class="statement">
      <h1 class="statement-text">Notes in the <em>margins</em>: thoughts, observations, and loose threads.</h1>
      <p class="statement-sub">Shorter than essays, written faster. <a href="/updates-rss.xml">RSS for notes</a></p>
    </div>

    <div class="margin">
      {months.map((month) => (
        <section class="month">
          <h2 class="group-h">{month}</h2>
          {updatesByMonth[month].map(async (update) => {
            const { Content } = await update.render();
            return (
              <article class="note">
                <p class="kicker">
                  {update.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}
                  {update.data.category && ` · ${update.data.category}`}
                </p>
                <h3 class="note-title"><a href={`/updates/${update.slug}/`}>{smart(update.data.title)}</a></h3>
                <div class="prose note-body"><Content /></div>
                {update.data.link && (
                  <a href={update.data.link} class="more" target="_blank" rel="noopener">{update.data.linkTitle || 'Link'}</a>
                )}
                {update.data.marginNote && <p class="aside">{update.data.marginNote}</p>}
              </article>
            );
          })}
        </section>
      ))}
    </div>
  </main>

  <Footer
    meta="Zerodha · Bangalore · The Internet<br>Thoughts captured before they could escape."
    hand="The best marginalia outlives the text it was scribbled on."
  />
</Layout>

<style>
  .month + .month { margin-top: 56px; }
  .note { padding: 16px 0 22px; border-top: 1px solid var(--rule); }
  .note-title { margin-top: 4px; font-family: var(--serif); font-weight: 400; font-size: 1.45rem; line-height: 1.2; }
  .note-title a:hover { color: var(--flame); }
  .note-body { margin-top: 10px; }
  .note-body :global(p) { font-size: 1.08rem; }
  .note-body :global(li) { font-size: 1.08rem; }
  .note .aside { margin-top: 12px; }
</style>
