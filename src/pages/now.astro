---
// Now: the latest entry as a letter, earlier entries below it. Derek Sivers' idea.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { nowEntries, fmtLong, smart } from '../utils/site';
const [now, ...earlier] = nowEntries;
const { Content } = now ? await render(now) : { Content: null };
const past = await Promise.all(earlier.map(async (e) => ({ e, C: (await render(e)).Content })));
---
<Base title="Now" description="What Bhuvan is doing right now: a /now page, updated when things change." active="Now" modified={now?.data.date} crumbs={[['Now', '/now/']]}>
  <header class="g phead">
    <span class="lbl ink">Now{now && <span class="lbl count">Updated <time datetime={now.data.date.toISOString()}>{fmtLong(now.data.date)}</time></span>}</span>
    <div class="tt">
      <h1>What I’m doing now. <span>A snapshot, not a résumé.</span></h1>
      <p>A <a href="https://nownownow.com/about">/now page</a>, an idea from Derek Sivers: what you’d tell a good friend who asked what you’ve been up to.</p>
    </div>
  </header>
  {now && (
    <section class="g nowpage">
      <div class="letter">
        {now.data.title && <h2 class="lbl ink">{smart(now.data.title)}</h2>}
        <div class="txt">{Content && <Content />}</div>
        <p class="sig">— B., Bangalore</p>
      </div>
    </section>
  )}
  {past.length > 0 && (
    <section class="g earlier" aria-labelledby="h-earlier">
      <h2 class="gl" id="h-earlier">Earlier</h2>
      <div class="list">
        {past.map(({ e, C }) => (
          <article>
            <time class="lbl" datetime={e.data.date.toISOString()}>{fmtLong(e.data.date)}</time>
            <div class="txt"><C /></div>
          </article>
        ))}
      </div>
    </section>
  )}
</Base>
