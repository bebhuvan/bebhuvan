---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const nowEntries = (await getCollection('now'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latestDate = nowEntries[0]?.data.date;
const categoryLabels: Record<string, string> = {
  thinking: 'Thinking about',
  working: 'Working on',
  mindlog: 'Mind log',
};
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title="Now — Bhuvan" description="What I'm doing right now — a /now page, updated when things change.">
  <Nav active="now" />

  <main class="split">
    <div class="statement">
      <h1 class="statement-text">What I’m doing <em>now</em>. A snapshot, not a résumé.</h1>
      <p class="statement-sub">
        {latestDate && <>Last updated {fmt(latestDate)}, Bangalore. </>}
        This is a <a href="https://nownownow.com/about">/now page</a>, an idea from Derek Sivers: what you’d tell a good friend who asked what you’ve been up to.
      </p>
    </div>

    <div class="margin">
      {nowEntries.map(async (entry, i) => {
        const { Content } = await entry.render();
        return (
          <section class="ann">
            <h2 class="ann-head"><span class="n">{i + 1}</span>{categoryLabels[entry.data.category] || entry.data.category}<span class="count">{entry.data.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}</span></h2>
            <div class="prose"><Content /></div>
          </section>
        );
      })}
    </div>
  </main>

  <Footer hand="This is me, right now. Ask me again in a month." />
</Layout>

<style>
  .margin .prose :global(p) { font-size: 1.12rem; }
</style>
