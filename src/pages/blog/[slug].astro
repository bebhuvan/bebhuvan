---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { smart } from '../../utils/typo';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await post.render();

const allPosts = (await getCollection('blog'))
  .filter(p => !p.data.draft && p.slug !== post.slug)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const date = fmt(post.data.publishDate);
const tags = post.data.tags || [];
const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : 0;

// Build a srcset for the hero image. Variants are generated by
// `scripts/build-images.mjs` and live next to the original as
// `<stem>-<width>w.webp`. We only emit srcset entries for variants
// that actually exist on disk.
function buildHeroSrcset(imagePath: string | undefined) {
  if (!imagePath) return null;
  const m = imagePath.match(/^(.*)\.webp$/);
  if (!m) return null;
  const stem = m[1];
  const widths = [480, 768, 1408];
  const root = process.cwd();
  const entries: string[] = [];
  for (const w of widths) {
    const rel = `${stem}-${w}w.webp`;
    if (existsSync(join(root, 'public', rel))) {
      entries.push(`${rel} ${w}w`);
    }
  }
  if (entries.length === 0) return null;
  return entries.join(', ');
}

const heroSrcset = buildHeroSrcset(post.data.image);
// margin notes: markdown footnotes plus legacy <span class="sn"> asides
const noteCount = ((post.body || '').match(/^\[\^[^\]]+\]:/gm) || []).length + ((post.body || '').match(/<span class="sn">/g) || []).length;
---

<Layout
  title={`${smart(post.data.title)} — Bhuvan`}
  description={smart(post.data.description)}
  image={post.data.image}
  imageAlt={post.data.imageCaption || post.data.title}
  type="article"
  publishDate={post.data.publishDate}
  keywords={tags}
  wordCount={wordCount || undefined}
  section={tags[0]}
  noindex={post.data.draft}
>
  <Nav active="writing" />

  <main class="read">
    <header class="read-head">
      <p class="read-line">
        <a href="/writing/">Essay</a>
        <span>{date}</span>
        {post.data.readingTime && <span>{post.data.readingTime}</span>}
        {post.data.draft && <span class="badge">Living draft</span>}
      </p>
      <h1 class="read-title">{smart(post.data.title)}</h1>
      <div class="read-sub">
        {post.data.description && <p class="read-dek">{smart(post.data.description)}</p>}
        {(noteCount > 0 || tags.length > 0) && (
          <dl class="colophon">
            {noteCount > 0 && <div><dt>In the margin</dt><dd>{noteCount} note{noteCount !== 1 ? 's' : ''}</dd></div>}
            {tags.length > 0 && <div><dt>Filed under</dt><dd>{tags.join(', ')}</dd></div>}
          </dl>
        )}
      </div>
    </header>

    {post.data.image && (
      <figure class="cover">
        <img
          src={post.data.image}
          srcset={heroSrcset || undefined}
          sizes={heroSrcset ? '(max-width: 700px) 100vw, 640px' : undefined}
          alt={post.data.imageCaption || post.data.title}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        {post.data.imageCaption && <figcaption>{post.data.imageCaption}</figcaption>}
      </figure>
    )}

    <article class="prose">
      <Content />
    </article>

    <footer class="read-end">
      {tags.length > 0 && <p class="tags"><b>Filed under</b>{tags.join(', ')}</p>}
      {allPosts.length > 0 && (
        <>
          <h2 class="group-h">More writing</h2>
          <ul class="list">
            {allPosts.map((p) => (
              <li><a class="row" href={`/blog/${p.slug}/`}><span class="t"><span class="hl">{smart(p.data.title)}</span></span><span class="d">{p.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span></a></li>
            ))}
          </ul>
          <a class="more" href="/writing/">All essays</a>
        </>
      )}
    </footer>
  </main>

  <Footer hand="Thanks for reading to the end. That's rare and I appreciate it." />
</Layout>
