---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { smart } from '../../utils/typo';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const updates = await getCollection('updates');
  return updates.map(update => ({
    params: { slug: update.id },
    props: { update },
  }));
};

const { update } = Astro.props;
const { Content } = await render(update);
---

<Layout title={`${smart(update.data.title)} — Bhuvan`} description={smart(update.data.title)} image={update.data.image} imageAlt={update.data.imageAlt}>
  <Nav active="marginalia" />

  <main class="read">
    <header class="read-head">
      <p class="crumb"><a href="/marginalia/">Notes</a></p>
      <h1 class="read-title note-title">{smart(update.data.title)}</h1>
      <div class="read-sub">
        <span></span>
        <p class="read-meta">
          {update.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          {update.data.category && <><br />{update.data.category}</>}
        </p>
      </div>
    </header>

    {update.data.image && (
      <figure class="cover">
        <img src={update.data.image} alt={update.data.imageAlt || update.data.title} width="1600" height="840" loading="eager" decoding="async" />
      </figure>
    )}

    <article class="prose">
      <Content />
      {update.data.marginNote && <p class="aside">{update.data.marginNote}</p>}
    </article>

    {update.data.link && (
      <footer class="read-end">
        <a class="more" href={update.data.link}>{update.data.linkTitle || 'Read more'}</a>
      </footer>
    )}
  </main>

  <Footer />
</Layout>

<style>
  .note-title { font-size: clamp(2.4rem, 5vw, 4.6rem); }
</style>
