---
// Elsewhere: the latest from my other writing, fetched when the site is built.
import Base from '../layouts/Base.astro';
import { aggregateRSSFeeds } from '../utils/rss-aggregator';
import { fmt } from '../utils/site';
let items: Awaited<ReturnType<typeof aggregateRSSFeeds>> = [];
try { items = await aggregateRSSFeeds(30); } catch {}
const sources = [
  { name: 'Substack', home: 'https://bhuvan.substack.com/', blurb: 'The newsletter' },
  { name: 'Paper Lanterns', home: 'https://paperlanterns.ink/', blurb: 'Letters and speeches from the public domain' },
];
---
<Base title="Elsewhere" description="The latest from Bhuvan’s other writing: the Substack and Paper Lanterns." crumbs={[['Elsewhere', '/trails/']]}>
  <header class="g phead">
    <span class="lbl ink">Elsewhere</span>
    <div class="tt">
      <h1>The latest from my other corners of the internet.</h1>
      <p>Gathered each time this site is built. For essays by other people worth an afternoon, see <a href="https://smallweb.blog/">Smallweb</a>.</p>
    </div>
  </header>
  {sources.map((s) => {
    const list = items.filter((i) => i.source === s.name).slice(0, 12);
    return (
      <section class="g trail" aria-label={s.name}>
        <div class="gl"><b>{s.name}</b><span class="dek">{s.blurb}</span><br /><a href={s.home}>Visit ↗</a></div>
        <ul class="rows">
          {list.length ? list.map((i) => <li><a href={i.link} rel="noopener"><b>{i.title}</b><span class="dek"></span><span class="d">{fmt(new Date(i.pubDate))}</span></a></li>) : <li><span class="dek">Couldn’t reach the feed when this page was built.</span></li>}
        </ul>
      </section>
    );
  })}
</Base>
