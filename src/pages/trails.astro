---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { aggregateRSSFeeds } from '../utils/rss-aggregator';

let rssItems: any[] = [];
try {
  rssItems = await aggregateRSSFeeds(20);
} catch (e) {}

const itemsByMonth = rssItems.reduce((acc, item) => {
  const key = new Date(item.pubDate).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
  (acc[key] ||= []).push(item);
  return acc;
}, {} as Record<string, typeof rssItems>);
const months = Object.keys(itemsByMonth);
---

<Layout title="Trails — Bhuvan" description="The latest from my other corners of the internet: my Substack, Rabbit Holes and Paper Lanterns.">
  <Nav active="trails" />

  <main class="split">
    <div class="statement">
      <h1 class="statement-text"><em>Trails</em>: the latest from my other corners of the internet, my Substack, Rabbit Holes and Paper Lanterns.</h1>
      <p class="statement-sub">Gathered each time the site is built. For essays by other people worth an afternoon, see <a href="https://smallweb.blog/">Smallweb</a>.</p>
    </div>

    <div class="margin">
      {rssItems.length === 0 && <p class="statement-sub">The feeds couldn’t be reached when this page was built.</p>}
      {months.map((month) => (
        <section class="month">
          <h2 class="group-h">{month}</h2>
          <ul class="list">
            {itemsByMonth[month].map((item) => (
              <li>
                <a class="row" href={item.link} target="_blank" rel="noopener">
                  <span class="t"><span class="hl">{item.title}</span></span>
                  <span class="d">{item.source} · {new Date(item.pubDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}</span>
                  {item.excerpt && <span class="x">{item.excerpt}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .month + .month { margin-top: 48px; }
</style>
