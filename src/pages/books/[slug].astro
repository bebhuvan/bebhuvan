---
// One book: author and when, a line from it, my verdict, then notes.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE, smart, fmtLong, bookHref, bookYear, plain, clip, topicHref, hasTopic } from '../../utils/site';

export async function getStaticPaths() {
  return (await getCollection('books')).map((b) => ({ params: { slug: b.id }, props: { b } }));
}
const { b } = Astro.props;
const d = b.data;
const { Content } = await render(b);
const year = bookYear(b);
const description = smart(d.hand) ? `${smart(d.title)} by ${d.author}: ${smart(d.hand)}` : clip(plain(b.body), 155) || `${smart(d.title)} by ${d.author}, read by Bhuvan.`;
const url = new URL(bookHref(b), SITE.url).toString();
const review = {
  '@type': 'Review',
  '@id': `${url}#review`,
  author: { '@id': `${SITE.url}/#person` },
  itemReviewed: { '@type': 'Book', name: smart(d.title), author: { '@type': 'Person', name: d.author } },
  ...(d.hand ? { reviewBody: smart(d.hand) } : {}),
  ...(d.date ? { datePublished: d.date.toISOString() } : {}),
  url,
};
const status = { reading: 'Reading now', read: 'Read', abandoned: 'Put down' }[d.status];
---
<Base title={`${smart(d.title)}, by ${d.author}`} description={description} active="Books" schema={[review]} crumbs={[['Books', '/books/'], [smart(d.title), bookHref(b)]]}>
  <article>
    <header class="g nhead">
      <div class="meta">
        <div><span class="lbl">Author</span>{d.author}</div>
        <div><span class="lbl">{status}</span>{d.date ? <time datetime={d.date.toISOString()}>{fmtLong(d.date)}</time> : year ?? ''}</div>
        {d.tags.length > 0 && <div class="tags"><span class="lbl">Filed under</span>{d.tags.map((t, k) => <>{k > 0 && ', '}{hasTopic(t) ? <a href={topicHref(t)}>{t}</a> : t}</>)}</div>}
      </div>
      <div class="tt">
        <h1>{smart(d.title)}</h1>
        {d.hand && <p class="aside">{smart(d.hand)}</p>}
      </div>
    </header>
    <div class="g ebody nbody">
      <div class="prose">
        {d.pull && <p class="pull">{smart(d.pull)}</p>}
        <Content />
        {d.link && <p><a href={d.link} rel="noopener">More about the book ↗</a></p>}
      </div>
      <div class="nend"><nav class="ends"><a href="/books/"><span class="lbl">← All books</span></a><span /></nav></div>
    </div>
  </article>
</Base>
