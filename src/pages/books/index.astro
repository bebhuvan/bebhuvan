---
import { getCollection } from 'astro:content';
import { smart } from '../../utils/typo';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

let books: any[] = [];
try {
  books = (await getCollection('books'))
    .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
} catch (e) {}

const booksByYear = books.reduce((acc, book) => {
  const year = book.data.year ?? 'Undated';
  (acc[year] ||= []).push(book);
  return acc;
}, {} as Record<string | number, typeof books>);
const years = Object.keys(booksByYear).sort((a, b) => Number(b) - Number(a));
---

<Layout title="Book Notes — Bhuvan" description="Not reviews — passages I loved, thoughts they sparked, connections they made.">
  <Nav active="books" />

  <main class="split">
    <div class="statement">
      <h1 class="statement-text">Book <em>notes</em>. Not reviews: passages I loved, thoughts they sparked, connections they made.</h1>
    </div>

    <div class="margin">
      {books.length === 0 && <p class="statement-sub">Book notes coming soon. In the meantime, I’m reading.</p>}
      {years.map((year) => (
        <section class="year">
          <h2 class="group-h">{year}<span>{booksByYear[year].length} book{booksByYear[year].length !== 1 ? 's' : ''}</span></h2>
          {booksByYear[year].map((book: any) => (
            <article class="book">
              <h3 class="b-title"><a href={`/books/${book.slug}/`}>{smart(book.data.title)}</a></h3>
              <p class="kicker">{book.data.author}{book.data.finishedDate ? ` · read ${book.data.finishedDate}` : ''}</p>
              {book.data.pull && <blockquote class="b-pull">{smart(book.data.pull)}</blockquote>}
              {book.data.hand && <p class="aside">{book.data.hand}</p>}
              <a class="more" href={`/books/${book.slug}/`}>Read the notes</a>
            </article>
          ))}
        </section>
      ))}
    </div>
  </main>

  <Footer
    meta="Bangalore · The Internet<br>Reading is just thinking that someone else started."
    hand="All of these are better than whatever you're about to read next. Probably."
  />
</Layout>

<style>
  .year + .year { margin-top: 48px; }
  .book { padding: 16px 0 24px; border-top: 1px solid var(--rule); }
  .b-title { font-family: var(--serif); font-weight: 400; font-size: 1.6rem; line-height: 1.15; }
  .b-title a:hover { color: var(--flame); }
  .book .kicker { margin-top: 6px; }
  .b-pull { margin-top: 14px; padding-left: 18px; border-left: 2px solid var(--flame); font-family: var(--serif); font-style: italic; font-size: 1.12rem; line-height: 1.5; }
  .book .aside { margin-top: 12px; }
</style>
