---
// Books: what I'm reading, then everything read, by year.
import Base from '../../layouts/Base.astro';
import { SITE, books, smart, bookHref, bookYear } from '../../utils/site';
const reading = books.filter((b) => b.data.status === 'reading');
const read = books.filter((b) => b.data.status !== 'reading');
const years = [...new Set(read.map((b) => bookYear(b) ?? 0))];
const list = { '@type': 'CollectionPage', '@id': `${SITE.url}/books/#collection`, name: 'Books', mainEntity: { '@type': 'ItemList', itemListElement: books.map((b, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(bookHref(b), SITE.url).toString(), name: smart(b.data.title) })) } };
---
<Base title="Books" description={`Books Bhuvan has read, with a line on each and notes on some: ${books.length} so far.`} active="Books" schema={[list]} crumbs={[['Books', '/books/']]}>
  <header class="g phead">
    <span class="lbl ink">Books · {books.length}</span>
    <div class="tt">
      <h1>What I read, with a line on each. <span>Some with notes and highlights.</span></h1>
      <p>Not reviews, more like the marks I leave in the margins. Ask me about any of them on <a href={SITE.twitter}>Twitter</a>.</p>
    </div>
  </header>
  {reading.length > 0 && (
    <section class="g reading" aria-labelledby="h-reading">
      <h2 class="gl" id="h-reading"><span class="num">→</span>Reading now</h2>
      <div class="list">{reading.map((b) => <div class="brow"><h3><a href={bookHref(b)}>{smart(b.data.title)}</a><span class="lbl">{b.data.author}</span></h3>{b.data.hand && <p class="verdict">{smart(b.data.hand)}</p>}</div>)}</div>
    </section>
  )}
  {years.map((y) => (
    <section class="g reading" aria-label={y ? String(y) : 'Undated'}>
      <h2 class="gl">{y || 'Earlier'}</h2>
      <div class="list">
        {read.filter((b) => (bookYear(b) ?? 0) === y).map((b) => (
          <div class="brow"><h3><a href={bookHref(b)}>{smart(b.data.title)}</a><span class="lbl">{b.data.author}{b.data.status === 'abandoned' && ' · put down'}</span></h3>{b.data.hand && <p class="verdict">{smart(b.data.hand)}</p>}</div>
        ))}
      </div>
    </section>
  ))}
</Base>
