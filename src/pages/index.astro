---
// Home: who, then writing, notes, building, collaborators, now and the shelf, as
// numbered sections on the grid.
import Base from '../layouts/Base.astro';
import Invite from '../components/Invite.astro';
import { render } from 'astro:content';
import { SITE, posts, notes, projects, nowEntries, books, short, fmt, fmtLong, smart, minutes, postHref, noteHref, bookHref, domain, excerpt, bookYear, srcset } from '../utils/site';

const lead = posts.find((p) => p.data.image) ?? posts[0];
const also = posts.filter((p) => p !== lead).slice(0, 4);
const featured = projects.filter((p) => p.data.featured && p.data.image).slice(0, 3);
const rest = projects.filter((p) => !featured.includes(p));
const latest = notes.slice(0, 6);
const cols = [latest.slice(0, 2), latest.slice(2, 4), latest.slice(4, 6)];
const now = nowEntries[0];
const { Content: NowText } = now ? await render(now) : { Content: null };
const reading = books.filter((b) => b.data.status === 'reading');
const shelf = [...reading, ...books.filter((b) => b.data.status === 'read')].slice(0, 5);
---
<Base title={`${SITE.name}: essays, notes and small websites`} description={SITE.description} type="profile" image="/og.jpg" home>
  <section class="g hero">
    <figure class="pic">
      <img src="/profile-pic.webp" srcset="/profile-pic-160.webp 160w, /profile-pic-640w.webp 640w, /profile-pic.webp 800w" sizes="(max-width: 860px) 50vw, 420px" alt="A cartoon of Bhuvan, grinning, with a peace sign" width="800" height="800" fetchpriority="high" />
    </figure>
    <div class="say">
      <h1>Doer of random things, diver of weird rabbit holes, sharer of fascinating things. <span>Hi, I’m Bhuvan.</span></h1>
      <p class="stand">By day I work at Zerodha on markets, data and curation. The rest of the time I write <a href="/writing/">long essays</a> that few people read, build <a href="/projects/">small websites</a> nobody asked for and keep <a href="/notes/">short notes</a> on whatever caught my eye.</p>
    </div>
  </section>

  <section class="g writing" aria-labelledby="h-writing">
    <h2 class="colh" id="h-writing"><span><span class="num">01</span>Writing</span><a class="more" href="/writing/">All {posts.length} essays</a></h2>
    <article class="cover">
      {lead.data.image && <a class="img" href={postHref(lead)} tabindex="-1" aria-hidden="true"><img src={lead.data.image} srcset={srcset(lead.data.image)} sizes="(max-width: 1100px) 100vw, 880px" alt="" width="1408" height="792" loading="lazy" decoding="async" /></a>}
      <span class="lbl meta">{lead.data.tags[0] && <span class="dom">{lead.data.tags[0]}</span>}{lead.data.tags[0] && ' · '}<time datetime={lead.data.publishDate.toISOString()}>{fmtLong(lead.data.publishDate)}</time> · {minutes(lead)} min</span>
      <h3><a href={postHref(lead)}>{smart(lead.data.title)}</a></h3>
      <p class="dek">{short(lead.data.description)}</p>
    </article>
    <aside class="also" aria-label="More essays">
      {also.map((p) => (
        <article>
          <time class="lbl" datetime={p.data.publishDate.toISOString()}>{fmt(p.data.publishDate)}</time>
          <h3><a href={postHref(p)}>{smart(p.data.title)}</a></h3>
          {short(p.data.description) && <p class="dek">{short(p.data.description)}</p>}
        </article>
      ))}
      <a class="more" href="/writing/">Every essay →</a>
    </aside>
  </section>

  <section class="g briefs" aria-labelledby="h-notes">
    <h2 class="colh" id="h-notes"><span><span class="num">02</span>Notes and links</span><a class="more" href="/notes/">All {notes.length} notes</a></h2>
    {cols.map((c) => (
      <div class="brief">
        {c.map((n) => (
          <div class="item">
            <span class="lbl"><time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>{n.data.url && <> · <span class="dom">{domain(n.data.url)}</span></>}</span>
            <h3><a href={noteHref(n)}>{smart(n.data.title)}</a></h3>
            <p>{excerpt(n, 220)}</p>
          </div>
        ))}
      </div>
    ))}
  </section>

  <section class="g building" aria-labelledby="h-building">
    <h2 class="colh" id="h-building"><span><span class="num">03</span>Building</span><a class="more" href="/projects/">All {projects.length} projects</a></h2>
    {featured.map((p, i) => (
      <a class:list={['shot', i === 0 ? 'big' : 'sm']} href={p.data.link}>
        <span class="frame"><img src={p.data.image} srcset={srcset(p.data.image, [768, 1400])} sizes={i === 0 ? '(max-width: 860px) 100vw, 880px' : '(max-width: 860px) 50vw, 430px'} alt={`The ${p.data.title} home page`} width="1280" height="800" loading="lazy" decoding="async" /></span>
        <h3>{smart(p.data.title)}</h3>
        <p class="dek">{smart(p.data.tagline ?? '')}</p>
        <span class="lbl dom">{p.data.url}</span>
      </a>
    ))}
    <div class="ptable">
      {rest.map((p) => <a href={p.data.link}><b>{smart(p.data.title)}</b><span>{smart(p.data.tagline ?? '')}</span></a>)}
    </div>
  </section>

  <Invite num="04" />

  <section class="g lower">
    {now && (
      <div class="now">
        <h2 class="colh"><span><span class="num">05</span><a href="/now/">Now</a></span><span class="lbl">Updated <time datetime={now.data.date.toISOString()}>{fmtLong(now.data.date)}</time></span></h2>
        <div class="txt">{NowText && <NowText />}</div>
        <p class="sig">— B.</p>
      </div>
    )}
    <div class="shelf">
      <h2 class="colh"><span><span class="num">06</span>On the shelf</span><a class="more" href="/books/">Books</a></h2>
      {shelf.map((b) => (
        <div class="row">
          <span class="lbl">{b.data.status === 'reading' ? 'Reading' : bookYear(b) ?? ''}</span>
          <span><a href={bookHref(b)}><strong>{smart(b.data.title)}</strong></a><em>{b.data.author}</em></span>
        </div>
      ))}
    </div>
  </section>
</Base>
