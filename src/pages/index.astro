---
// Home: one sentence about me, pinned on the left. Its numbered words are the
// navigation; what they point to lives in the margin on the right.
import { getCollection, render } from 'astro:content';
import { smart } from '../utils/typo';
import { groupProjects } from '../utils/projects';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const [latest, ...rest] = posts;

const notes = (await getCollection('updates'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

const projects = (await getCollection('projects'))
  .filter((p) => p.data.status !== 'archived')
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const books = (await getCollection('books'))
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));

const nowEntries = (await getCollection('now'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const nowLatest = nowEntries[0];
const NowContent = nowLatest ? (await render(nowLatest)).Content : null;

// "From the margins": one margin note from the archive, pulled at build time.
// Sources: markdown footnotes ([^n]: …) and legacy <span class="sn"> asides in
// essays, plus `marginNote` on short notes. The pick rotates by build day.
const plain = (md: string) => md
  .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')   // [text](url) → text
  .replace(/[*_`]/g, '')
  .replace(/<[^>]+>/g, '')
  .trim();
type Aside = { text: string; title: string; href: string };
const asides: Aside[] = [
  ...posts.flatMap((p) => {
    const body = p.body || '';
    const found = [
      ...[...body.matchAll(/^\[\^[^\]]+\]:\s*(.+)$/gm)].map((m) => m[1]),
      ...[...body.matchAll(/<span class="sn">([\s\S]*?)<\/span>/g)].map((m) => m[1]),
    ];
    return found.map((t) => ({ text: plain(t), title: p.data.title, href: `/blog/${p.id}/` }));
  }),
  ...(await getCollection('updates'))
    .filter((u) => u.data.marginNote)
    .map((u) => ({ text: u.data.marginNote!, title: u.data.title, href: `/updates/${u.id}/` })),
].filter((a) => a.text.length > 20 && a.text.length < 240);
const day = Math.floor(Date.now() / 86_400_000);
const aside = asides.length ? asides[day % asides.length] : null;

const projectGroups = groupProjects(projects);
// WordPress-era descriptions were cut off with an ellipsis; those read worse than none
const dek = (d?: string) => (d && !/(\.\.\.|…)\s*$/.test(d) ? smart(d) : '');

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const fmtShort = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---

<Layout title="Bhuvan">
  <Nav />

  <main class="split">
    <div class="statement">
      <h1 class="statement-text">
        I’m Bhuvan. By day I work at Zerodha on markets, data and curation. The rest of the time I <span class="ph" data-k="essays">write essays<a class="r" href="#essays" aria-label="Essays">1</a></span> that few people read, <span class="ph" data-k="websites">build small websites<a class="r" href="#websites" aria-label="Projects">2</a></span> nobody asked for, <span class="ph" data-k="notes">keep short notes<a class="r" href="#notes" aria-label="Notes">3</a></span> on whatever caught my eye, and <span class="ph" data-k="books">write about the books<a class="r" href="#books" aria-label="Books">4</a></span> I loved. <span class="ph" data-k="now">Right now<a class="r" href="#now" aria-label="Now">5</a></span> I’m lost in the treasures hiding in the public domain, and what on earth to do with them.
      </h1>
      <div class="signature">
        <img class="portrait" src="/profile-pic-160.webp" alt="Bhuvan" width="44" height="44" loading="eager" decoding="async" />
        <p class="statement-sub">Doer of random things, diver of weird rabbit holes, sharer of fascinating things. Bangalore. <span class="links"><a href="/rss.xml">RSS</a> · <a href="https://twitter.com/bhuvanesh2007">Twitter</a></span></p>
      </div>
      {aside && (
        <figure class="from-margins">
          <figcaption class="fm-label">From the margins</figcaption>
          <blockquote class="fm-text">{smart(aside.text)}</blockquote>
          <p class="fm-src">A note in <a href={aside.href}>{smart(aside.title)}</a></p>
        </figure>
      )}
    </div>

    <div class="margin">
      <section class="ann" id="essays">
        <h2 class="ann-head"><span class="n">1</span>Essays <span class="count">{posts.length}</span></h2>
        {latest && (
          <article class="featured">
            <p class="kicker">{fmt(latest.data.publishDate)}</p>
            <h3 class="featured-title"><a href={`/blog/${latest.id}/`}>{smart(latest.data.title)}</a></h3>
            {latest.data.description && <p class="featured-dek">{smart(latest.data.description)}</p>}
          </article>
        )}
        <ul class="second">
          {rest.slice(0, 2).map((p) => (
            <li><a class="sec" href={`/blog/${p.id}/`}>
              <span class="kicker">{fmt(p.data.publishDate)}</span>
              <span class="sec-t"><span class="hl">{smart(p.data.title)}</span></span>
              {dek(p.data.description) && <span class="sec-x">{dek(p.data.description)}</span>}
            </a></li>
          ))}
        </ul>
        <ul class="list tight">
          {rest.slice(2, 6).map((p) => (
            <li><a class="row" href={`/blog/${p.id}/`}><span class="t"><span class="hl">{smart(p.data.title)}</span></span><span class="d">{fmtShort(p.data.publishDate)}</span></a></li>
          ))}
        </ul>
        <a class="more" href="/writing/">All {posts.length} essays</a>
      </section>

      <section class="ann" id="websites">
        <h2 class="ann-head"><span class="n">2</span>Projects <span class="count">{projects.length}</span></h2>
        {projectGroups.map((g) => (
          <div class="pg">
            <h3 class="pg-h">{g.label}</h3>
            <ul>
              {g.items.map((p) => (
                <li><a class="prow" href={p.data.link || '/projects/'}><span class="pn"><span class="hl">{smart(p.data.title)}</span></span>{p.data.tagline && <span class="pt">{smart(p.data.tagline)}</span>}</a></li>
              ))}
            </ul>
          </div>
        ))}
        <a class="more" href="/projects/">What each one is</a>
      </section>

      <section class="ann" id="notes">
        <h2 class="ann-head"><span class="n">3</span>Notes</h2>
        <ul class="list">
          {notes.map((n) => (
            <li><a class="row" href={`/updates/${n.id}/`}><span class="t"><span class="hl">{smart(n.data.title)}</span></span><span class="d">{fmt(n.data.publishDate)}</span></a></li>
          ))}
        </ul>
        <a class="more" href="/marginalia/">All notes</a>
      </section>

      {books.length > 0 && (
        <section class="ann" id="books">
          <h2 class="ann-head"><span class="n">4</span>Books <span class="count">{books.length}</span></h2>
          <ul class="list">
            {books.map((b) => (
              <li><a class="row" href={`/books/${b.id}/`}><span class="t"><span class="hl">{smart(b.data.title)}</span></span><span class="d">{b.data.author}</span></a></li>
            ))}
          </ul>
          <a class="more" href="/books/">Book notes</a>
        </section>
      )}

      {nowLatest && NowContent && (
        <section class="ann" id="now">
          <h2 class="ann-head"><span class="n">5</span>Now <span class="count">{fmt(nowLatest.data.date)}</span></h2>
          <div class="prose now-snippet"><NowContent /></div>
          <a class="more" href="/now/">What I’m doing now</a>
        </section>
      )}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* Essays: three levels. The lead (global .featured), two with their deks, then a compact list. */
  .featured { padding-bottom: 24px; border-bottom: 1px solid var(--rule); }
  .second { list-style: none; }
  .sec { display: grid; gap: 6px; padding: 18px 0; border-bottom: 1px solid var(--rule); }
  .sec-t { font-family: var(--serif); font-size: 1.3rem; line-height: 1.25; letter-spacing: -.005em; text-wrap: balance; }
  .sec-x { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 1.04rem; line-height: 1.45; color: var(--ink-soft); text-wrap: pretty;
           display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .sec:hover .hl { background-size: 100% var(--marker-h); }
  .tight .row { padding: 8px 0; }
  .tight .t { font-size: 1.02rem; }

  /* Projects: grouped as on /projects; each name says what it is */
  .pg + .pg { margin-top: 26px; }
  .pg-h { padding-bottom: 7px; border-bottom: 1px solid var(--rule-strong); font-size: .7rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); }
  .pg ul { list-style: none; }
  .prow { display: grid; grid-template-columns: 11.5em minmax(0, 1fr); gap: 2px 18px; align-items: baseline; padding: 8px 0; border-bottom: 1px solid var(--rule); }
  .pn { font-family: var(--serif); font-size: 1.08rem; line-height: 1.3; }
  .pt { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 1rem; line-height: 1.4; color: var(--ink-soft); }
  .prow:hover .hl { background-size: 100% var(--marker-h); }

  @media (max-width: 600px) {
    /* the compact list keeps its date on the same line, at the right */
    .tight .row { grid-template-columns: minmax(0, 1fr) auto; gap: 2px 14px; }
    .tight .row .d { order: 0; }
    .sec-t { font-size: 1.22rem; }
    .prow { grid-template-columns: minmax(0, 1fr); gap: 1px; }
  }

  .now-snippet :global(p) { font-size: 1.1rem; }

  /* From the margins: one note from the archive, set like a margin note */
  .from-margins { margin-top: 9vh; max-width: 30em; padding-left: 18px; border-left: 1px solid var(--flame); }
  .fm-label { font-weight: 600; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--flame); }
  .fm-text { margin-top: 8px; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 1.22rem; line-height: 1.45; color: var(--ink); text-wrap: pretty; }
  .fm-src { margin-top: 10px; font-size: .86rem; color: var(--ink-soft); }
  .fm-src a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--flame); text-underline-offset: 3px; }
  .fm-src a:hover { color: var(--flame); }

  /* The sentence and its margin answer each other (CSS only).
     Hover a reference: its annotation stays, the others step back.
     Hover an annotation: its number in the sentence lights up. */
  .ann { transition: opacity .3s; }
  .split:has(.r:hover) .ann { opacity: .28; }
  .split:has(.r[href="#essays"]:hover) #essays,
  .split:has(.r[href="#websites"]:hover) #websites,
  .split:has(.r[href="#notes"]:hover) #notes,
  .split:has(.r[href="#books"]:hover) #books,
  .split:has(.r[href="#now"]:hover) #now { opacity: 1; }
  /* hovering a reference or its annotation sweeps the highlighter under the phrase */
  .split:has(.r[href="#essays"]:hover, #essays:hover) .ph[data-k="essays"],
  .split:has(.r[href="#websites"]:hover, #websites:hover) .ph[data-k="websites"],
  .split:has(.r[href="#notes"]:hover, #notes:hover) .ph[data-k="notes"],
  .split:has(.r[href="#books"]:hover, #books:hover) .ph[data-k="books"],
  .split:has(.r[href="#now"]:hover, #now:hover) .ph[data-k="now"],
  .ph:has(.r:focus-visible) { background-size: 100% var(--marker-h); }
  .ann:target .ann-head { color: var(--flame); }

  /* the pinned column is nearly a screen tall here; on short screens let it scroll */
  @media (max-height: 860px) and (min-width: 861px) {
    .statement { position: static; }
  }
  @media (max-width: 860px) {
    .from-margins { margin-top: 44px; }
  }
</style>
