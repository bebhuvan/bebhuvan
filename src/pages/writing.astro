---
// Every essay, by year.
import Base from '../layouts/Base.astro';
import { SITE, posts, short, fmt, smart, postHref } from '../utils/site';
const years = [...new Set(posts.map((p) => p.data.publishDate.getFullYear()))];
const list = { '@type': 'CollectionPage', '@id': `${SITE.url}/writing/#collection`, name: 'Essays', mainEntity: { '@type': 'ItemList', numberOfItems: posts.length, itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(postHref(p), SITE.url).toString(), name: smart(p.data.title) })) } };
---
<Base title="Writing" description={`All ${posts.length} essays by Bhuvan, on money, markets, technology, history and books, from ${years.at(-1)} to now.`} active="Writing" schema={[list]} crumbs={[['Writing', '/writing/']]}>
  <header class="g phead">
    <span class="lbl ink">Essays · {posts.length}</span>
    <div class="tt">
      <h1>Long essays that few people read. <span>Money, technology, history and the occasional rant.</span></h1>
      <p>Everything since {years.at(-1)}, newest first. There are shorter things in the <a href="/notes/">notes</a>, and the essays come by <a href="/writing/rss.xml">RSS</a> too.</p>
    </div>
  </header>
  {years.map((y) => {
    const ps = posts.filter((p) => p.data.publishDate.getFullYear() === y);
    return (
      <section class="g year" aria-label={String(y)}>
        <h2 class="gl">{y}<span class="lbl">{ps.length} {ps.length === 1 ? 'essay' : 'essays'}</span></h2>
        <ul class="rows">
          {ps.map((p) => <li><a class="with-dek" href={postHref(p)}><b class="tt">{smart(p.data.title)}</b>{short(p.data.description) && <span class="dek">{short(p.data.description)}</span>}<time class="d" datetime={p.data.publishDate.toISOString()}>{fmt(p.data.publishDate)}</time></a></li>)}
        </ul>
      </section>
    );
  })}
</Base>
