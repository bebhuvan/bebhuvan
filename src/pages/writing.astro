---
import { getCollection } from 'astro:content';
import { smart } from '../utils/typo';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Tally from '../components/Tally.astro';

const all = await getCollection('blog');
const posts = all
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const draftCount = all.filter((p) => p.data.draft).length;

const postsByYear = posts.reduce((acc, post) => {
  const year = post.data.publishDate.getFullYear();
  (acc[year] ||= []).push(post);
  return acc;
}, {} as Record<number, typeof posts>);
const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
const firstYear = years[years.length - 1];

// Descriptions imported from the old WordPress blog are truncated excerpts
// ending in an ellipsis; only show descriptions that were written as such.
const cleanDescription = (d?: string) => (d && !/(\.\.\.|…)\s*$/.test(d) ? d : '');
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
---

<Layout title="Writing — Bhuvan" description="Long-form essays — the workshop, not the gallery.">
  <Nav active="writing" />

  <main class="split">
    <div class="statement">
      <h1 class="statement-text">Long-form <em>writing</em>. The workshop, not the gallery; nothing here is quite finished.</h1>
      <p class="statement-sub">{posts.length} essays since {firstYear}{draftCount > 0 ? `, and ${draftCount} living draft${draftCount !== 1 ? 's' : ''}` : ''}. Newest first.</p>
      <Tally items={[{ n: posts.length, label: 'Essays' }, { n: postsByYear[years[0]].length, label: `In ${years[0]}` }, { n: firstYear, label: 'Since' }]} />
    </div>

    <div class="margin">
      {years.map((year) => (
        <section>
          <h2 class="group-h">{year}<span>{postsByYear[year].length} essay{postsByYear[year].length !== 1 ? 's' : ''}</span></h2>
          <ul class="list">
            {postsByYear[year].map((post) => (
              <li>
                <a class="row" href={`/blog/${post.slug}/`}>
                  <span class="t"><span class="hl">{smart(post.data.title)}</span></span>
                  <span class="d">{fmt(post.data.publishDate)}</span>
                  {cleanDescription(post.data.description) && <span class="x">{smart(cleanDescription(post.data.description))}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>

  <Footer
    meta={`Bangalore · The Internet<br>${posts.length} essays and counting. Most of them unfinished. All of them honest.`}
    hand="Writing is just thinking with better posture."
  />
</Layout>
