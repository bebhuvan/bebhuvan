---
// LAB directions, B "Edition": the home page as a title page, a preface and a table of contents.
import '../../../styles/lab/b.css';
import Frame from '../../../components/lab/BFrame.astro';
import { render } from 'astro:content';
import { posts, projects, stream, nowEntries, dek, short, fmt, fmtLong, smart, kinds, kindLabel, GITHUB, TWITTER, today } from '../../../utils/lab';
const first = posts[posts.length - 1].data.publishDate.getFullYear();
const recent = posts.slice(0, 12);
const years = [...new Set(recent.map((p) => p.data.publishDate.getFullYear()))];
const month = (d: Date) => d.toLocaleDateString('en-GB', { month: 'long' });
const featured = projects.filter((p) => p.data.story).slice(0, 4);
const now = nowEntries[0];
const { Content: NowText } = await render(now);
const E = '/lab/b/essay/';
---
<Frame title="Lab B · Edition — Bhuvan">
  <section class="title-page">
    <img src="/profile-pic.webp" alt="A cartoon of Bhuvan, grinning, with a peace sign" width="800" height="800" />
    <h1>Bhuvan</h1>
    <p class="sub">Essays, notes and small websites by a doer of random things and diver of weird rabbit holes</p>
    <span class="fleuron">❧</span>
    <p class="imprint sc">Bangalore<span>First edition {first} · revised {today.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</span></p>
  </section>

  <section class="block">
    <div class="chap"><span class="num sc">Preface</span></div>
    <div class="preface">
      <p>I’m Bhuvan. By day I work at Zerodha on markets, data and curation. The rest of the time I write essays that few people read, build small websites nobody asked for, and keep short notes on whatever caught my eye.</p>
      <p>This is where all of it lives. The <a href={E}>essays</a> are long, about money, technology and the odd thing I can’t stop thinking about. The <a href="/lab/b/notes/">notes</a> are short, mostly links with a line on why. The <a href="/lab/b/projects/">projects</a> are small sites for old words and Indian numbers, and most of them could use another pair of hands.</p>
      <p class="sign">— B.</p>
    </div>
  </section>

  <section class="block">
    <div class="chap"><span class="num sc">I</span><h2>Contents</h2><p>The latest essays, newest first</p></div>
    <div class="contents">
      {years.map((y) => (
        <>
          <p class="yr sc">{y}</p>
          <ol class="toc">
            {recent.filter((p) => p.data.publishDate.getFullYear() === y).map((p, i) => (
              <li><a href={E}>
                <span class="line"><span class="t">{smart(p.data.title)}</span><span class="dots"></span><span class="m sc">{month(p.data.publishDate)}</span></span>
                {short(p.data.description) && <span class="arg">{short(p.data.description)}</span>}
              </a></li>
            ))}
          </ol>
        </>
      ))}
      <span class="whole sc"><a href={E}>The complete contents, {posts.length} essays</a></span>
    </div>
  </section>

  <section class="block">
    <div class="chap"><span class="num sc">II</span><h2>Works</h2><p>Small websites, made on evenings and weekends</p></div>
    <div class="works">
      <div class="work-grid">
        {featured.map((p) => (
          <article class="work">
            <h3><a href={p.data.link}>{smart(p.data.title)}</a></h3>
            <p class="tag">{smart(p.data.tagline ?? '')}</p>
            <p class="desc">{smart(p.data.description)}</p>
            <p class="note">“{smart(p.data.story ?? '')}”</p>
            <a class="url" href={p.data.link}>{p.data.url}</a>
          </article>
        ))}
      </div>
      <span class="whole sc"><a href="/lab/b/projects/">All {projects.length} works</a></span>
      <div class="invite" id="invite">
        <h3>An invitation</h3>
        <p>I make these alone. If you read old Indian languages, know where forgotten books and letters are kept, or like building small careful websites, I would love the company.</p>
        <div class="ways"><a class="sc" href={GITHUB}>GitHub</a><a class="sc" href={TWITTER}>Write to me</a></div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="chap"><span class="num sc">III</span><h2>Commonplace</h2><p>Notes and links, lately</p></div>
    <div class="common">
      {stream.slice(0, 6).map((n) => (
        <div class="cp">
          <h3><a href={n.kind === 'link' ? n.href : '/lab/b/notes/'}>{n.title}</a></h3>
          <div class="meta">{fmt(n.date)}{n.domain && <> · from <span class="it">{n.domain}</span></>}</div>
          <p>{n.text}</p>
        </div>
      ))}
      <span class="whole sc"><a href="/lab/b/notes/">The whole commonplace book</a></span>
    </div>
  </section>

  <section class="block" id="now">
    <div class="chap"><span class="num sc">Postscript</span><h2>Now</h2><p>Written {fmtLong(now.data.date)}</p></div>
    <div class="ps"><NowText /></div>
  </section>
</Frame>
