---
// LAB directions, B: notes as a commonplace book, dates hung in the margin.
import '../../../styles/lab/b.css';
import Frame from '../../../components/lab/BFrame.astro';
import { stream, fmt } from '../../../utils/lab';
---
<Frame title="Lab B · Commonplace — Bhuvan" active="Notes">
  <header class="opening">
    <span class="kick sc">Notes and links</span>
    <h1>Commonplace</h1>
    <p class="arg">Things worth keeping: links with a line on why, quotes and half-thoughts. Formerly kept at rabbitholes.garden.</p>
  </header>
  <div class="cp-page">
    {stream.map((n) => (
      <article class="cp-entry">
        <time class="sc">{fmt(n.date)}</time>
        <h3>{n.kind === 'link' ? <a href={n.href}>{n.title}</a> : n.title}</h3>
        {n.domain && <p class="via">from <a href={n.href}>{n.domain}</a></p>}
        <div class="txt">{n.html ? <Fragment set:html={n.html} /> : <p>{n.text}</p>}</div>
      </article>
    ))}
  </div>
</Frame>
