---
// LAB round 2, C: "Chart". Everything Bhuvan has written and built since 2021
// on one chart: time runs left to right, subjects run top to bottom. Each
// essay is a dot with its title; each website a flame mark at its launch. The
// density is the story (2022 is all markets; 2024 is nearly empty). Labels
// are laid out at build time into lanes so none collide. Subject assignments
// and launch months are drafts.
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { posts, post, project, href, smart } from '../../utils/lab';

const bands = [
  { name: 'Money and markets', essays: ['speculation', 'philosophy-of-money', 'rare-disease', 'institutional', 'stories-that-cause', 'grandfathers', 'death-to-the-banks', 'boy-who-cried', 'spactacular', 'yield-curve', 'what-a-time', 'miser', 'trillion', 'niall', 'so-long', 'whats-old', 'no-it-isnt'],
    built: [['tipsheet', '2026-09']] },
  { name: 'India and the world', essays: ['protest', 'dear-influencers', 'dear-fintechs', 'never-better', 'russia-ukraine', 'stop-zuckerberg', 'revolution-in-a-box'],
    built: [['this-indian', '2026-06'], ['hope-and-despair', '2026-06'], ['measure-of-india', '2026-09'], ['soochi', '2026-10'], ['let-me-walk', '2026-10']] },
  { name: 'Reading, writing and the web', essays: ['philosophy-of-life', 'dhwani', 'escalate', 'before-we-had', 'ripple', 'go-curate', 'too-much-of-everything', 'start-the-damn-blog', 'hello-world', 'broken-news', 'a-world-without-news'],
    built: [['paper-lanterns', '2025-08'], ['rabbit-holes', '2025-08'], ['seneca', '2025-09'], ['collections', '2025-11'], ['dumpsterfire', '2025-11'], ['akshara', '2025-12'], ['smallweb', '2026-06']] },
  { name: 'Machines, work and living', essays: ['train-dreams', 'fuck-around', 'fragmented-thoughts', 'without-a-job', 'work-from-home'],
    built: [] },
];

const t0 = +new Date('2021-04-01'), t1 = +new Date('2026-12-31');
const pct = (d: Date) => ((+d - t0) / (t1 - t0)) * 100;
const PW = 770;          // plot width the lanes are computed for (the narrowest the chart is shown at)
const LABEL = 250;       // max label width in px, CSS truncates beyond
const est = (s: string) => Math.min(s.length * 6.6, LABEL) + 18;
const LANE = 30;

type Mark = { kind: 'essay' | 'site'; title: string; url: string; date: Date; x: number; right: boolean; lane: number };
const laid = bands.map((b) => {
  const marks: Mark[] = [
    ...b.essays.map((k) => { const p = post(k); return { kind: 'essay' as const, title: smart(p.data.title), url: href(p), date: p.data.publishDate }; }),
    ...b.built.map(([k, m]) => { const p = project(k); return { kind: 'site' as const, title: smart(p.data.title), url: p.data.link!, date: new Date(m + '-15') }; }),
  ].sort((a, z) => +a.date - +z.date)
   .map((m) => ({ ...m, x: pct(m.date), right: pct(m.date) > 74, lane: 0 }));
  // greedy lanes: put each label in the first lane where its span is free
  const lanes: [number, number][][] = [];
  for (const m of marks) {
    const px = (m.x / 100) * PW, w = est(m.title);
    const span: [number, number] = m.right ? [px - w, px + 6] : [px - 6, px + w];
    let i = lanes.findIndex((l) => l.every(([a, z]) => span[1] < a || span[0] > z));
    if (i < 0) { lanes.push([]); i = lanes.length - 1; }
    lanes[i].push(span); m.lane = i;
  }
  return { ...b, marks, height: Math.max(lanes.length, 1) * LANE + 10 };
});
const years = [2022, 2023, 2024, 2025, 2026];
---

<Layout title="Lab: chart — Bhuvan" noindex>
  <Nav />

  <header class="ch-head">
    <h1>I’m Bhuvan. Since 2021 I’ve written {posts.length} essays and built a dozen small websites, mostly about the same few things.</h1>
    <p class="key"><span class="k-e"></span>Essay <span class="k-s"></span>Website launched</p>
  </header>

  <main class="chart" style={`--lane: ${LANE}px`}>
    <div class="axis">
      <span class="band-name"></span>
      <div class="plot"><span class="yr first">2021</span>{years.map((y) => <span class="yr" style={`left: ${pct(new Date(`${y}-01-01`))}%`}>{y}</span>)}</div>
    </div>
    {laid.map((b) => (
      <section class="band">
        <h2 class="band-name">{b.name}<span>{b.marks.filter((m) => m.kind === 'essay').length} essays{b.built.length ? `, ${b.built.length} site${b.built.length > 1 ? 's' : ''}` : ''}</span></h2>
        <div class="plot" style={`height: ${b.height}px`}>
          {years.map((y) => <span class="grid" style={`left: ${pct(new Date(`${y}-01-01`))}%`}></span>)}
          {b.marks.map((m) => (
            <a class:list={['mark', m.kind, { right: m.right }]} href={m.url} style={`left: ${m.x}%; top: ${m.lane * LANE + 6}px`}>
              <span class="pt"></span><span class="lb"><span class="hl">{m.title}</span></span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>

  <!-- narrow screens: the same data as a list by subject -->
  <div class="ch-list">
    {laid.map((b) => (
      <section>
        <h2>{b.name}</h2>
        <ul>{[...b.marks].reverse().map((m) => <li class={m.kind}><a href={m.url}><span>{m.title}</span><span class="d">{m.kind === 'site' ? 'Site · ' : ''}{m.date.getFullYear()}</span></a></li>)}</ul>
      </section>
    ))}
  </div>

  <Footer />
</Layout>

<style>
  .ch-head, .chart, .ch-list { max-width: var(--frame); margin: 0 auto; padding: 0 var(--pad); }
  .ch-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; padding-top: 11vh; padding-bottom: 7vh; }
  .ch-head h1 { max-width: 21em; font-family: var(--serif); font-weight: 300; font-size: clamp(1.9rem, 2.8vw, 2.8rem); line-height: 1.2; letter-spacing: -.012em; text-wrap: pretty; }
  .key { flex: none; display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); }
  .k-e, .k-s { display: inline-block; width: 7px; height: 7px; background: var(--ink); border-radius: 50%; }
  .k-s { background: var(--flame); border-radius: 0; transform: rotate(45deg); margin-left: 14px; }

  .axis, .band { display: grid; grid-template-columns: 200px minmax(0, 1fr); column-gap: 24px; }
  .axis { position: sticky; top: 0; z-index: 2; background: var(--paper); padding: 10px 0 8px; border-bottom: 1px solid var(--rule-strong); }
  .axis .plot { position: relative; height: 1.2em; }
  .yr { position: absolute; top: 0; font-weight: 600; font-size: .7rem; letter-spacing: .1em; color: var(--ink); font-variant-numeric: tabular-nums; transform: translateX(-50%); }
  .yr.first { left: 0; transform: none; }
  .band { border-bottom: 1px solid var(--rule); padding: 18px 0 14px; }
  .band-name { font-family: var(--serif); font-weight: 300; font-size: 1.35rem; line-height: 1.15; letter-spacing: -.008em; }
  .band-name span { display: block; margin-top: 8px; font-family: var(--grot); font-weight: 600; font-size: .64rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); }
  .plot { position: relative; }
  .grid { position: absolute; top: -18px; bottom: -14px; border-left: 1px solid var(--rule); }

  .mark { position: absolute; display: flex; align-items: center; gap: 7px; height: 22px; white-space: nowrap; }
  .mark .pt { flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--ink); margin-left: -3.5px; }
  .mark.site .pt { background: var(--flame); border-radius: 0; transform: rotate(45deg); }
  .mark .lb { max-width: 250px; overflow: hidden; text-overflow: ellipsis; font-family: var(--serif); font-size: .84rem; line-height: 1.2; color: var(--ink); }
  .mark.site .lb { font-family: var(--grot); font-weight: 600; font-size: .66rem; letter-spacing: .08em; text-transform: uppercase; color: var(--flame); }
  .mark.right { flex-direction: row-reverse; transform: translateX(-100%); }
  .mark.right .pt { margin-left: 0; margin-right: -3.5px; }
  .mark:hover { z-index: 1; }
  .mark:hover .lb { overflow: visible; background: var(--paper); }
  .mark:hover .hl { background-size: 100% var(--marker-h); }

  .ch-list { display: none; }
  @media (max-width: 1080px) {
    .chart { display: none; }
    .ch-head { flex-direction: column; align-items: flex-start; padding-top: 6vh; }
    .ch-list { display: block; }
    .ch-list section { margin-bottom: 40px; }
    .ch-list h2 { padding-bottom: 8px; border-bottom: 1px solid var(--rule-strong); font-family: var(--serif); font-weight: 300; font-size: 1.5rem; }
    .ch-list ul { list-style: none; }
    .ch-list a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px; align-items: baseline; padding: 9px 0; border-bottom: 1px solid var(--rule); font-family: var(--serif); font-size: 1.06rem; line-height: 1.3; }
    .ch-list .d { font-family: var(--grot); font-weight: 600; font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); }
    .ch-list .site a { color: var(--flame); }
  }
</style>
