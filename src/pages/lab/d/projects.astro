---
// LAB directions, D: three spreads with pictures, then every project as a table by group.
import '../../../styles/lab/d.css';
import Frame from '../../../components/lab/DFrame.astro';
import { projects, smart, shot, kinds, kindLabel, GITHUB, TWITTER } from '../../../utils/lab';
const featured = ['senecas-letters', 'hope-and-despair', 'let-me-walk'].map((k) => projects.find((p) => p.id === k)!);
const blurb: Record<string, string> = { library: 'Old letters, speeches and books, set to be read', numbers: 'Indian data, explained in plain language', reading: 'What I read, kept in the open', street: 'Bengaluru, on the record' };
---
<Frame title="Lab D · Projects — Bhuvan" active="Projects">
  <header class="g phead">
    <span class="lbl ink">Projects · {projects.length}</span>
    <div class="tt">
      <h1>Small websites, built on evenings and weekends. <span>Each one started as an itch.</span></h1>
      <p>Old letters set to be read, Indian data explained, a commonplace book and a record of Bengaluru’s broken footpaths. If one of them is your itch too, <a href="#invite">come and help</a>.</p>
    </div>
  </header>
  {featured.map((p) => (
    <article class="g spread">
      <a class="frame" href={p.data.link}><img src={shot(p.id)} alt={`The ${p.data.title} home page`} /></a>
      <div class="txt">
        <span class="lbl"><span class="sq"></span>{kindLabel[p.data.kind ?? 'library']}</span>
        <h2><a href={p.data.link}>{smart(p.data.title)}</a></h2>
        <p class="desc">{smart(p.data.description)}</p>
        {p.data.story && <p class="why">“{smart(p.data.story)}”</p>}
        <a class="url" href={p.data.link}>{p.data.url} ↗</a>
      </div>
    </article>
  ))}
  {kinds.map((k, i) => (
    <section class="g group">
      <div class="gl"><b><span class="num">0{i + 1}</span>{kindLabel[k]}</b><span class="dek">{blurb[k]}</span></div>
      <div class="gt">
        {projects.filter((p) => p.data.kind === k).map((p) => (
          <div class="prow">
            <h3><a href={p.data.link}>{smart(p.data.title)}</a></h3>
            <p class="desc">{smart(p.data.description)}</p>
            <a class="url" href={p.data.link}>{p.data.url} ↗</a>
          </div>
        ))}
      </div>
    </section>
  ))}
  <section class="invite" id="invite">
    <div class="g">
      <div class="colh"><span>Collaborators wanted</span></div>
      <h2>I build all of this alone, on evenings and weekends. <span>Come and build some of it with me.</span></h2>
      <div class="rest">
        <p>Every one of these needs more hands than mine. A few places to start:</p>
        <ol>
          <li>Readers of Kannada, Tamil, Hindi or Sanskrit to proof old books</li>
          <li>People who know where rare Indian books and letters are hiding</li>
          <li>Designers and developers who like small, careful websites</li>
        </ol>
        <a class="btn" href={GITHUB}>github.com/bebhuvan ↗</a><a class="btn ghost" href={TWITTER}>Write to me</a>
      </div>
    </div>
  </section>
</Frame>
