---
// LAB directions, D: C's grid and numbered sections carrying A's portrait, cover story,
// screenshots and flame invitation, with everything you read at length in the serif.
import '../../../styles/lab/d.css';
import Frame from '../../../components/lab/DFrame.astro';
import { render } from 'astro:content';
import { posts, projects, stream, nowEntries, books, dek, short, fmt, fmtLong, smart, shot, minutes, GITHUB, TWITTER } from '../../../utils/lab';
const lead = posts.find((p) => p.data.image)!;
const also = posts.filter((p) => p !== lead).slice(0, 4);
const featured = ['senecas-letters', 'hope-and-despair', 'let-me-walk'].map((k) => projects.find((p) => p.id === k)!);
const rest = projects.filter((p) => !featured.includes(p));
const cols = [stream.slice(0, 2), stream.slice(2, 4), stream.slice(4, 6)];
const now = nowEntries[0];
const { Content: NowText } = await render(now);
const shelf = [...books].sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0)).slice(0, 4);
const E = '/lab/d/essay/';
---
<Frame title="Lab D · Contributor on the grid — Bhuvan">
  <section class="g hero">
    <figure class="pic">
      <img src="/profile-pic.webp" alt="A cartoon of Bhuvan, grinning, with a peace sign" width="800" height="800" />
    </figure>
    <div class="say">
      <h1>Doer of random things, diver of weird rabbit holes, sharer of fascinating things. <span>Hi, I’m Bhuvan.</span></h1>
      <p class="stand">By day I work at Zerodha on markets, data and curation. The rest of the time I write <a href={E}>long essays</a> that few people read, build <a href="/lab/d/projects/">small websites</a> nobody asked for and keep <a href="/lab/d/notes/">short notes</a> on whatever caught my eye.</p>
      <div class="facts">
        <div><span class="lbl">Based in</span><br />Bangalore, India</div>
        <div><span class="lbl">Writing since</span><br />{posts[posts.length - 1].data.publishDate.getFullYear()}, {posts.length} essays</div>
        <div><span class="lbl">Looking for</span><br /><a href="#invite">Collaborators →</a></div>
      </div>
    </div>
  </section>

  <section class="g writing">
    <div class="colh"><span><span class="num">01</span>Writing</span><a class="more" href={E}>All {posts.length} essays</a></div>
    <article class="cover">
      <a class="img" href={E}><img src={lead.data.image} alt="" /></a>
      <span class="lbl meta"><span class="dom">{(lead.data.tags ?? ['Essay'])[0]}</span> · {fmtLong(lead.data.publishDate)} · {minutes(lead)} min</span>
      <h2><a href={E}>{smart(lead.data.title)}</a></h2>
      <p class="dek">{short(lead.data.description)}</p>
    </article>
    <aside class="also">
      {also.map((p) => (
        <article>
          <span class="lbl">{fmt(p.data.publishDate)}</span>
          <h3><a href={E}>{smart(p.data.title)}</a></h3>
          {short(p.data.description) && <p class="dek">{short(p.data.description)}</p>}
        </article>
      ))}
      <a class="more" href={E}>Every essay →</a>
    </aside>
  </section>

  <section class="g briefs">
    <div class="colh"><span><span class="num">02</span>Notes and links</span><a class="more" href="/lab/d/notes/">All notes</a></div>
    {cols.map((c) => (
      <div class="brief">
        {c.map((n) => (
          <div class="item">
            <span class="lbl">{fmt(n.date)}{n.domain && <> · <span class="dom">{n.domain}</span></>}</span>
            <h3><a href={n.kind === 'link' ? n.href : '/lab/d/notes/'}>{n.title}</a></h3>
            <p>{n.text}</p>
          </div>
        ))}
      </div>
    ))}
  </section>

  <section class="g building">
    <div class="colh"><span><span class="num">03</span>Building</span><a class="more" href="/lab/d/projects/">All {projects.length} projects</a></div>
    {featured.map((p, i) => (
      <a class:list={['shot', i === 0 ? 'big' : 'sm']} href={p.data.link}>
        <span class="frame"><img src={shot(p.id)} alt="" /></span>
        <h3>{smart(p.data.title)}</h3>
        <p class="dek">{smart(p.data.tagline ?? '')}</p>
        <span class="lbl dom">{p.data.url}</span>
      </a>
    ))}
    <div class="ptable">
      {rest.map((p) => <a href={p.data.link}><b>{smart(p.data.title)}</b><span>{smart(p.data.tagline ?? '')}</span></a>)}
    </div>
  </section>

  <section class="invite" id="invite">
    <div class="g">
      <div class="colh"><span><span class="num" style="color:inherit">04</span>Collaborators wanted</span></div>
      <h2>I build all of this alone, on evenings and weekends. <span>Come and build some of it with me.</span></h2>
      <div class="rest">
        <p>Every one of these needs more hands than mine. A few places to start:</p>
        <ol>
          <li>Readers of Kannada, Tamil, Hindi or Sanskrit to proof old books</li>
          <li>People who know where rare Indian books and letters are hiding</li>
          <li>Designers and developers who like small, careful websites</li>
        </ol>
        <a class="btn" href={GITHUB}>github.com/bebhuvan ↗</a><a class="btn ghost" href={TWITTER}>Write to me</a>
      </div>
    </div>
  </section>

  <section class="g lower" id="now">
    <div class="now">
      <div class="colh"><span><span class="num">05</span>Now</span><span class="lbl">Updated {fmtLong(now.data.date)}</span></div>
      <div class="txt"><NowText /></div>
      <p class="sig">— B.</p>
    </div>
    <div class="shelf">
      <div class="colh"><span><span class="num">06</span>On the shelf</span><a class="more" href="/books/">Books</a></div>
      {shelf.map((b) => <div class="row"><span class="lbl">{b.data.year ?? ''}</span><span><strong>{smart(b.data.title)}</strong><em>{b.data.author}</em></span></div>)}
    </div>
  </section>
</Frame>
