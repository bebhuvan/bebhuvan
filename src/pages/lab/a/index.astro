---
// LAB directions, A "Contributor": the home page as a magazine's opening pages about one person.
import '../../../styles/lab/a.css';
import Frame from '../../../components/lab/AFrame.astro';
import { render } from 'astro:content';
import { posts, projects, stream, nowEntries, books, dek, fmt, fmtLong, smart, shot, GITHUB, TWITTER, minutes } from '../../../utils/lab';
const lead = posts.find((p) => p.data.image)!;
const also = posts.filter((p) => p !== lead).slice(0, 4);
const featured = ['senecas-letters', 'hope-and-despair', 'let-me-walk'].map((k) => projects.find((p) => p.id === k)!);
const rest = projects.filter((p) => !featured.includes(p));
const cols = [stream.slice(0, 2), stream.slice(2, 4), stream.slice(4, 6)];
const now = nowEntries[0];
const { Content: NowText } = await render(now);
const shelf = [...books].sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0)).slice(0, 4);
const E = '/lab/a/essay/';
---
<Frame title="Lab A · Contributor — Bhuvan">
  <main class="wrap">
    <section class="open">
      <figure class="portrait">
        <img src="/profile-pic.webp" alt="A cartoon of Bhuvan, grinning, with a peace sign" width="800" height="800" />
        <figcaption class="cap">The author, roughly</figcaption>
      </figure>
      <div>
        <span class="cap fl">About the author</span>
        <h1>Doer of random things, diver of weird <em>rabbit holes</em>, sharer of fascinating things.</h1>
        <p class="stand">I’m Bhuvan. By day I work at Zerodha on markets, data and curation. The rest of the time I write <a href={E}>long essays</a> that few people read, build <a href="/lab/a/projects/">small websites</a> nobody asked for and keep <a href="/lab/a/notes/">short notes</a> on whatever caught my eye. I live in Bangalore.</p>
        <div class="find"><a class="more" href="#now">What I’m doing now</a><a class="more" href="#invite">Work with me</a></div>
      </div>
    </section>

    <section class="cover-story">
      <div>
        <div class="dept"><h2>The <b>latest essay</b></h2><span class="cap soft">{posts.length} essays since 2020</span></div>
        <a class="lead-img" href={E}><img src={lead.data.image} alt="" /></a>
        <div class="lead-txt">
          <div>
            <span class="cap fl">{(lead.data.tags ?? ['Essay'])[0]} <span class="soft">· {fmt(lead.data.publishDate)} · {minutes(lead)} min</span></span>
            <h3><a href={E}>{smart(lead.data.title)}</a></h3>
            <p>{dek(lead.data.description)}</p>
          </div>
        </div>
      </div>
      <aside class="also">
        <div class="dept"><h2><b>Also</b> in writing</h2></div>
        {also.map((p) => (
          <article>
            <span class="cap soft">{fmt(p.data.publishDate)}</span>
            <h4><a href={E}>{smart(p.data.title)}</a></h4>
            {dek(p.data.description) && <p>{dek(p.data.description)}</p>}
          </article>
        ))}
        <a class="more" href={E}>All {posts.length} essays</a>
      </aside>
    </section>

    <section class="briefs">
      <div class="dept"><h2><b>Notes</b> &amp; links</h2><a class="more" href="/lab/a/notes/">All notes</a></div>
      <div class="brief-grid">
        {cols.map((c) => (
          <div class="brief">
            {c.map((n) => (
              <div class="brief-item">
                <span class="cap soft">{fmt(n.date)}{n.domain && <> · <span class="src">{n.domain}</span></>}</span>
                <h4><a href={n.kind === 'link' ? n.href : '/lab/a/notes/'}>{n.title}</a></h4>
                <p>{n.text}</p>
              </div>
            ))}
          </div>
        ))}
      </div>
    </section>

    <section class="workshop">
      <div class="dept"><h2>The <b>workshop</b></h2><a class="more" href="/lab/a/projects/">All {projects.length} projects</a></div>
      <div class="shots">
        {featured.map((p) => (
          <a class="shot" href={p.data.link}>
            <span class="frame"><img src={shot(p.id)} alt="" /></span>
            <h4>{smart(p.data.title)}</h4>
            <p>{smart(p.data.tagline ?? '')}</p>
            <span class="cap">{p.data.url}</span>
          </a>
        ))}
      </div>
      <ul class="index-list">
        {rest.map((p) => <li><a href={p.data.link}>{smart(p.data.title)}</a><span>{smart(p.data.tagline ?? '')}</span></li>)}
      </ul>
    </section>
  </main>

  <section class="invite" id="invite">
    <div class="wrap invite-in">
      <div>
        <span class="cap">Collaborators wanted</span>
        <h3>I build all of this alone, on evenings and weekends. <em>Come and build some of it with me.</em></h3>
      </div>
      <div>
        <p>Every one of these needs more hands than mine. A few places to start:</p>
        <ul>
          <li>Readers of Kannada, Tamil, Hindi or Sanskrit to proof old books</li>
          <li>People who know where rare Indian books and letters are hiding</li>
          <li>Designers and developers who like small, careful websites</li>
        </ul>
        <a class="btn" href={GITHUB}>GitHub: bebhuvan ↗</a><a class="btn ghost" href={TWITTER}>Write to me</a>
      </div>
    </div>
  </section>

  <main class="wrap">
    <section class="now-shelf" id="now">
      <div>
        <div class="dept"><h2>Right <b>now</b></h2><span class="cap soft">Updated {fmtLong(now.data.date)}</span></div>
        <div class="now-letter"><NowText /></div>
        <p class="now-sig">— B.</p>
      </div>
      <div>
        <div class="dept"><h2>On the <b>shelf</b></h2><a class="more" href="/books/">Books</a></div>
        <div class="side-list">
          {shelf.map((b) => <div><span class="cap soft">{b.data.year ?? ''}</span><span><strong>{smart(b.data.title)}</strong><em>{b.data.author}</em></span></div>)}
        </div>
      </div>
    </section>
  </main>
</Frame>
