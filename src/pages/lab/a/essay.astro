---
// LAB directions, A: the essay as a magazine feature.
import '../../../styles/lab/a.css';
import Frame from '../../../components/lab/AFrame.astro';
import { render } from 'astro:content';
import { essay, posts, dek, fmtLong, smart, minutes, thumb } from '../../../utils/lab';
const { Content } = await render(essay);
const next = posts.filter((p) => p !== essay && p.data.image).slice(0, 3);
---
<Frame title={`Lab A · ${essay.data.title}`} active="Writing">
  <main class="wrap">
    <header class="feat-head">
      <span class="cap fl kicker">Essay · {(essay.data.tags ?? [])[0]}</span>
      <h1>{smart(essay.data.title)}</h1>
      <p class="dek">{dek(essay.data.description)}</p>
      <div class="byline"><img src="/profile-pic-160.webp" alt="" /><b>By Bhuvan</b><span class="cap soft">{fmtLong(essay.data.publishDate)} · {minutes(essay)} min read</span></div>
    </header>
    <figure class="feat-cover">
      <img src={essay.data.image} alt="" />
      <figcaption><span class="cap soft">{essay.data.imageCaption ?? 'Cover: a classical painting of a railway station'}</span></figcaption>
    </figure>
    <div class="body-grid">
      <article class="prose"><Content /></article>
      <div class="end-box">
        <img src="/profile-pic-160.webp" alt="" />
        <div>
          <p><b>Bhuvan</b> works at Zerodha on markets, data and curation, and writes here about money, technology and whatever else he can’t stop thinking about.</p>
          <a class="more" href="/rss.xml">Follow by RSS</a>
        </div>
      </div>
    </div>
    <section class="next">
      <div class="dept"><h2><b>Keep</b> reading</h2></div>
      <div class="next-grid">
        {next.map((p) => (
          <a href="/lab/a/essay/">
            <img src={thumb(p.data.image)} alt="" />
            <span class="cap soft">{fmtLong(p.data.publishDate)}</span>
            <h4>{smart(p.data.title)}</h4>
            <p>{dek(p.data.description)}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</Frame>
