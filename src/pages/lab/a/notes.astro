---
// LAB directions, A: notes and link posts (Rabbit Holes folded in) as one stream.
import '../../../styles/lab/a.css';
import Frame from '../../../components/lab/AFrame.astro';
import { stream, fmt } from '../../../utils/lab';
---
<Frame title="Lab A · Notes — Bhuvan" active="Notes">
  <main class="wrap notes-page">
    <aside class="notes-side">
      <span class="cap fl">Notes &amp; links</span>
      <h1>Short things, kept in the open.</h1>
      <p>Links worth your time with a line on why, quotes, half-thoughts and the occasional rant. This used to live at rabbitholes.garden.</p>
      <div class="legend">
        <span class="cap soft"><span class="src">source.com</span> &nbsp;a link, with my note</span>
        <span class="cap soft">No source &nbsp;a note of my own</span>
      </div>
    </aside>
    <div class="stream">
      {stream.map((n) => (
        <article class:list={['entry', n.kind]}>
          <time class="cap">{fmt(n.date)}</time>
          <div>
            {n.kind === 'link' && <span class="cap via"><span class="src">{n.domain}</span></span>}
            <h2>{n.kind === 'link' ? <a href={n.href}>{n.title}</a> : n.title}</h2>
            <div class="txt">{n.html ? <Fragment set:html={n.html} /> : <p>{n.text}</p>}</div>
          </div>
        </article>
      ))}
    </div>
  </main>
</Frame>
