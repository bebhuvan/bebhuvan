---
// LAB directions, C: projects as a typographic table in four groups, no pictures.
import '../../../styles/lab/c.css';
import Frame from '../../../components/lab/CFrame.astro';
import { projects, smart, kinds, kindLabel, GITHUB, TWITTER } from '../../../utils/lab';
const blurb: Record<string, string> = { library: 'Old letters, speeches and books, set to be read', numbers: 'Indian data, explained in plain language', reading: 'What I read, kept in the open', street: 'Bengaluru, on the record' };
---
<Frame title="Lab C · Projects — Bhuvan" active="Projects">
  <header class="g phead">
    <span class="lbl ink">Projects · {projects.length}</span>
    <h1>Small websites, built on evenings and weekends. <span>Each one started as an itch. If it’s your itch too, come and help.</span></h1>
  </header>
  {kinds.map((k, i) => (
    <section class="g group">
      <div class="gl"><b><span class="num">0{i + 1}</span>{kindLabel[k]}</b><span class="lbl">{blurb[k]}</span></div>
      <div class="gt">
        {projects.filter((p) => p.data.kind === k).map((p) => (
          <div class="prow">
            <h3><a href={p.data.link}>{smart(p.data.title)}</a></h3>
            <p class="desc">{smart(p.data.description)}{p.data.story && <i>“{smart(p.data.story)}”</i>}</p>
            <a class="url" href={p.data.link}>{p.data.url} ↗</a>
          </div>
        ))}
      </div>
    </section>
  ))}
  <section class="g" style="padding-bottom: 20px">
    <div class="collab wide" id="collab">
      <div class="colh"><span><span class="num" style="color:inherit">05</span>Open to collaborators</span></div>
      <h3>I build these alone. Come and build some of them with me.</h3>
      <div class="rest">
        <ol>
          <li>Read Kannada, Tamil, Hindi or Sanskrit and can proof old books</li>
          <li>Know where rare Indian books and letters are kept</li>
          <li>Like designing or building small, careful websites</li>
        </ol>
        <a class="btn" href={GITHUB}>github.com/bebhuvan</a><a class="btn" href={TWITTER}>Write to me</a>
      </div>
    </div>
  </section>
</Frame>
