---
// LAB directions, C: the essay on the grid, set in the grotesk.
import '../../../styles/lab/c.css';
import Frame from '../../../components/lab/CFrame.astro';
import { render } from 'astro:content';
import { essay, posts, dek, fmtLong, fmtMonth, smart, minutes } from '../../../utils/lab';
const { Content } = await render(essay);
const next = posts.filter((p) => p !== essay).slice(0, 6);
---
<Frame title={`Lab C · ${essay.data.title}`} active="Writing">
  <header class="g ehead">
    <div class="meta">
      <div><span class="lbl">Essay</span>{(essay.data.tags ?? []).join(', ')}</div>
      <div><span class="lbl">Published</span>{fmtLong(essay.data.publishDate)}</div>
      <div><span class="lbl">Reading time</span>{minutes(essay)} minutes</div>
    </div>
    <div class="tt">
      <h1>{smart(essay.data.title)}</h1>
      <p class="dek">{dek(essay.data.description)}</p>
    </div>
  </header>
  <section class="g ecover">
    <figure><img src={essay.data.image} alt="" /><figcaption class="lbl">{essay.data.imageCaption ?? 'Cover: a railway station, in oils'}</figcaption></figure>
  </section>
  <div class="g ebody"><article class="prose"><Content /></article></div>
  <section class="g enext">
    <div class="sh"><span><span class="num">→</span>More essays</span><a href="/lab/c/essay/">All {posts.length}</a></div>
    <ul class="rows" style="grid-column: 1 / -1">
      {next.map((p) => <li><a href="/lab/c/essay/"><span>{smart(p.data.title)}</span><span class="d">{fmtMonth(p.data.publishDate)}</span></a></li>)}
    </ul>
  </section>
</Frame>
