---
// LAB (structure study A): the home page as a short letter. Annotated taken
// to its end: every essay, project and book the letter mentions is footnoted,
// and the thing itself sits in the margin beside the line that names it.
// Below the letter, the whole archive as a back-of-book index.
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { posts, notes, projects, books, post, project, book, note, thumb, dek, fmt, href, smart } from '../../utils/lab';
import { groupProjects } from '../../utils/projects';

const rare = post('rare-disease'), protest = post('protest'), train = post('train-dreams');
const rooms = projects.filter((p) => p.data.kind === 'library'), numbers = projects.filter((p) => p.data.kind === 'numbers');
const perry = note('perry'), weeks = book('four-thousand'), weeksTitle = weeks.data.title.split(':')[0];

const byYear = posts.reduce((acc, p) => { (acc[p.data.publishDate.getFullYear()] ||= []).push(p); return acc; }, {} as Record<number, typeof posts>);
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
const d = (x: Date) => x.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
---

<Layout title="Lab: the letter — Bhuvan" noindex>
  <Nav />

  <main class="lt">
    <aside class="rail">
      <img class="portrait" src="/profile-pic-160.webp" alt="" width="56" height="56" />
      <p class="dateline">Bangalore<br />October 2026</p>
    </aside>

    <div class="letter">
      <p class="lead">I’m Bhuvan. I live in Bangalore and work at Zerodha, where my days go to markets, data and curation. My evenings go to everything else, which is most of what you’ll find here.</p>

      <p>I write essays that few people read. Some are about money and the people who talk about it, like the rare disease spreading through India’s finance commentariat.<sup class="ref">1</sup><span class="ln ln-essay">
        <a href={href(rare)}><img src={thumb(rare.data.image)} alt="" /><span class="k">Essay · {fmt(rare.data.publishDate)}</span><span class="t">{smart(rare.data.title)}</span></a></span>
        Some are about the country, like why you should defend the right to protest, especially if you hate the protesters.<sup class="ref">2</sup><span class="ln ln-essay">
        <a href={href(protest)}><span class="k">Essay · {fmt(protest.data.publishDate)}</span><span class="t">{smart(protest.data.title)}</span></a></span>
        And some are about whatever got under my skin that month, like a quiet film about a logger<sup class="ref">3</sup><span class="ln ln-essay">
        <a href={href(train)}><span class="k">Essay · {fmt(train.data.publishDate)}</span><span class="t">{smart(train.data.title)}</span></a></span> I couldn’t stop thinking about. There are {posts.length} of them so far.</p>

      <p>I also build small websites nobody asked for. Most are rooms for old words,<sup class="ref">4</sup><span class="ln ln-proj">
        <a href="/projects/"><span class="k">Rooms for old words</span>{rooms.map((p) => <span class="pr"><span class="t">{smart(p.data.title)}</span> <span class="u">{p.data.url}</span></span>)}</a></span>
        like all 124 of Seneca’s letters, set to be read one at a time, or rare Indian books rescued from bad scans. Others are ways to read the country in numbers.<sup class="ref">5</sup><span class="ln ln-proj">
        <a href="/projects/"><span class="k">In numbers</span><span class="run">{numbers.map((p) => smart(p.data.title)).join(' · ')}</span></a></span>
        There are {projects.length} in all, and every one of them started as a weekend thing.</p>

      <p>I keep short notes on whatever caught my eye, most recently a goodbye to Perry Mehrling,<sup class="ref">6</sup><span class="ln ln-note">
        <a href={`/updates/${perry.id}/`}><span class="k">Note · {fmt(perry.data.publishDate)}</span><span class="t">{perry.data.title}</span></a></span>
        and I write about the books I loved, like <cite>{weeksTitle}</cite>,<sup class="ref">7</sup><span class="ln ln-book">
        <a href={`/books/${weeks.id}/`}><span class="q">{smart(weeks.data.pull!)}</span><span class="k">{weeks.data.author}</span></a></span>
        which changed how I spend my time. Right now<sup class="ref">8</sup><span class="ln ln-now">
        <a href="/now/"><span class="k">Now · updated 23 Dec 2025</span><span class="x">Building akshara.ink with LLMs, and surprised every week by what they make possible.</span></a></span>
        I’m lost in the treasures hiding in the public domain, and what on earth to do with them.</p>

      <p class="sign">Bhuvan</p>
    </div>
  </main>

  <section class="index" aria-label="Index">
    <h2 class="index-h">Index <span>Everything on the site, newest first</span></h2>
    <div class="cols">
      <div class="col-group">
        <h3>Essays</h3>
        {years.map((y) => (
          <div class="yr">
            <h4>{y}</h4>
            <ul>{byYear[y].map((p) => <li><a href={href(p)}>{smart(p.data.title)}</a><span class="dt">{d(p.data.publishDate)}</span></li>)}</ul>
          </div>
        ))}
      </div>
      <div class="col-group">
        <h3>Projects</h3>
        {groupProjects(projects).map((g) => (
          <div class="yr">
            <h4>{g.label}</h4>
            <ul>{g.items.map((p) => <li><a href={p.data.link}>{p.data.title}</a><span class="dt">{p.data.url}</span></li>)}</ul>
          </div>
        ))}
        <h3>Notes</h3>
        <ul>{notes.map((n) => <li><a href={`/updates/${n.id}/`}>{smart(n.data.title.trim())}</a><span class="dt">{fmt(n.data.publishDate)}</span></li>)}</ul>
        <h3>Books</h3>
        <ul>{books.map((b) => <li><a href={`/books/${b.id}/`}>{b.data.title.split(':')[0]}</a><span class="dt">{b.data.author}</span></li>)}</ul>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .lt {
    --nw: 290px; --gap: 64px; --lm: 37rem;
    display: grid; grid-template-columns: 170px minmax(0, var(--lm)) minmax(0, 1fr); column-gap: var(--gap);
    max-width: var(--frame); margin: 0 auto; padding: 14vh var(--pad) 0;
  }
  .rail { padding-top: .5rem; }
  .portrait { width: 56px; height: 56px; border-radius: 50%; filter: grayscale(1); }
  .dateline { margin-top: 14px; font-weight: 600; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; line-height: 1.6; color: var(--ink-soft); }

  .letter { font-family: var(--serif); font-weight: 300; font-size: 1.42rem; line-height: 1.6; color: var(--ink); font-variant-numeric: oldstyle-nums; }
  .letter p + p { margin-top: 1.1em; }
  .letter p { text-wrap: pretty; }
  .letter .lead { font-size: 2.15rem; line-height: 1.32; letter-spacing: -.008em; margin-bottom: 1.4em; }
  .letter cite { font-style: italic; }
  .ref { font-family: var(--grot); font-weight: 600; font-size: .5em; color: var(--flame); line-height: 0; vertical-align: .9em; margin-left: .1em; }
  .sign { font-style: italic; color: var(--flame); margin-top: 1.4em !important; }

  /* the margin: each note floats beside the line that names it */
  .ln {
    float: right; clear: right; width: var(--nw); margin-right: calc(-1 * (var(--nw) + var(--gap)));
    margin-top: .35em; margin-bottom: 26px; font-size: 1rem; line-height: 1.4; font-weight: 400;
    font-variant-numeric: lining-nums;
  }
  .ln a { display: grid; gap: 3px; padding-left: 14px; border-left: 1px solid var(--rule); transition: border-color .2s; }
  .ln a:hover { border-left-color: var(--flame); }
  .ln .k { font-family: var(--grot); font-weight: 600; font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); }
  .ln .t { font-size: 1.06rem; line-height: 1.28; color: var(--ink); text-wrap: balance; }
  .ln .x { font-style: italic; font-weight: 300; font-size: .98rem; line-height: 1.4; color: var(--ink-soft); }
  .ln .u { font-family: var(--grot); font-weight: 500; font-size: .74rem; letter-spacing: .02em; color: var(--flame); }
  .ln .q { font-style: italic; font-weight: 300; font-size: 1.08rem; line-height: 1.4; color: var(--ink); }
  .ln-essay img { width: 100%; aspect-ratio: 16 / 6; object-fit: cover; margin-bottom: 8px; filter: saturate(.85); }
  .ln-proj a { gap: 2px; }
  .ln-proj .k { margin-bottom: 4px; }
  .pr { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; padding: 3px 0; border-bottom: 1px solid var(--rule); }
  .pr .u { font-size: .68rem; }
  .run { font-size: 1.04rem; line-height: 1.5; }

  /* the index: the archive set like the back of a book */
  .index { max-width: var(--frame); margin: 16vh auto 0; padding: 0 var(--pad); }
  .index-h { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 10px; border-bottom: 1px solid var(--rule-strong);
             font-family: var(--serif); font-weight: 300; font-size: 2rem; letter-spacing: -.01em; }
  .index-h span { font-family: var(--grot); font-weight: 600; font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); }
  .cols { display: grid; grid-template-columns: 2fr 1fr; gap: 0 var(--split-gap); margin-top: 28px; }
  .col-group:first-child { columns: 2; column-gap: 48px; column-rule: 1px solid var(--rule); }
  .col-group h3 { font-weight: 600; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--flame); margin: 0 0 12px; column-span: all; }
  .col-group h3 + * { margin-top: 0; }
  .col-group ul + h3 { margin-top: 30px; }
  .yr { break-inside: avoid; margin-bottom: 22px; }
  .yr h4 { font-family: var(--serif); font-weight: 400; font-size: 1.3rem; line-height: 1; margin-bottom: 6px; font-variant-numeric: oldstyle-nums; }
  .yr:not(:has(h4:only-child)) h4 { font-variant-numeric: oldstyle-nums; }
  .index ul { list-style: none; }
  .index li { font-family: var(--serif); font-size: 1rem; line-height: 1.35; padding: 3px 0 3px 1em; text-indent: -1em; break-inside: avoid; }
  .index li a:hover { color: var(--flame); }
  .index .dt { font-family: var(--grot); font-weight: 500; font-size: .66rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); margin-left: .6em; white-space: nowrap; }

  @media (max-width: 1240px) {
    .lt { grid-template-columns: minmax(0, var(--lm)) minmax(0, 1fr); --gap: 48px; --nw: 260px; }
    .rail { grid-column: 1 / -1; display: flex; align-items: center; gap: 14px; margin-bottom: 36px; }
    .dateline { margin-top: 0; }
  }
  @media (max-width: 960px) {
    .lt { grid-template-columns: minmax(0, 1fr); padding-top: 6vh; }
    .ln { float: none; display: block; width: auto; margin: .8em 0 1em; }
    .ln-essay a:has(img) { grid-template-columns: 88px minmax(0, 1fr); column-gap: 14px; }
    .ln-essay img { grid-row: span 3; aspect-ratio: 1; margin: 0; }
    .cols { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 600px) {
    .letter { font-size: 1.2rem; }
    .letter .lead { font-size: 1.6rem; }
    .col-group:first-child { columns: 1; }
    .index-h { font-size: 1.6rem; flex-direction: column; gap: 4px; }
  }
</style>
