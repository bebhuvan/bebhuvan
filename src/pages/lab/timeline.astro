---
// LAB round 3: the timeline, done properly. Time runs down the page, newest at
// the top, one grid row per month, so a busy month stretches and a quiet year
// stays a gap. Subjects are columns; the websites have a column of their own.
// A title's size says how long the essay is. Each year's number is pinned in
// the rail while you scroll through that year. No dots, no truncation.
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { posts, post, project, href, smart } from '../../utils/lab';

const subjects = [
  { name: 'Money & markets', essays: ['speculation', 'philosophy-of-money', 'rare-disease', 'institutional', 'stories-that-cause', 'grandfathers', 'death-to-the-banks', 'boy-who-cried', 'spactacular', 'yield-curve', 'what-a-time', 'miser', 'trillion', 'niall', 'so-long', 'whats-old', 'no-it-isnt'] },
  { name: 'India & the world', essays: ['protest', 'dear-influencers', 'dear-fintechs', 'never-better', 'russia-ukraine', 'stop-zuckerberg', 'revolution-in-a-box'] },
  { name: 'Reading & writing', essays: ['philosophy-of-life', 'dhwani', 'escalate', 'before-we-had', 'ripple', 'go-curate', 'too-much-of-everything', 'start-the-damn-blog', 'hello-world', 'broken-news', 'a-world-without-news'] },
  { name: 'Machines & living', essays: ['train-dreams', 'fuck-around', 'fragmented-thoughts', 'without-a-job', 'work-from-home'] },
];
const launches: [string, string][] = [
  ['paper-lanterns', '2025-08'], ['rabbit-holes', '2025-08'], ['seneca', '2025-09'], ['collections', '2025-11'],
  ['dumpsterfire', '2025-11'], ['akshara', '2025-12'], ['hope-and-despair', '2026-06'], ['smallweb', '2026-06'],
  ['this-indian', '2026-06'], ['measure-of-india', '2026-09'], ['tipsheet', '2026-09'], ['soochi', '2026-10'], ['let-me-walk', '2026-10'],
];
const chapter: Record<number, string> = {
  2026: 'Back to essays, and seven more websites.',
  2025: 'The year the side projects took over.',
  2024: 'One essay. Mostly I read.',
  2023: 'Banks kept failing, so I kept writing about them.',
  2022: 'Nearly all of it about markets.',
  2021: 'Hello, world.',
};

type Item = { kind: 'essay' | 'site'; col: number; date: Date; title: string; url: string; size?: number; sub?: string };
const items: Item[] = [
  ...subjects.flatMap((s, col) => s.essays.map((k) => {
    const p = post(k);
    const words = (p.body || '').split(/\s+/).filter(Boolean).length;
    // title size from essay length: ~400 words → 1, ~4000 words → 1.75 (a multiplier of the base size)
    const size = Math.min(1.75, Math.max(1, 1 + (Math.sqrt(words) - 20) / 60 * 0.75));
    return { kind: 'essay' as const, col, date: p.data.publishDate, title: smart(p.data.title), url: href(p), size: +size.toFixed(3) };
  })),
  ...launches.map(([k, m]) => {
    const p = project(k);
    return { kind: 'site' as const, col: subjects.length, date: new Date(m + '-15'), title: smart(p.data.title), url: p.data.link!, sub: p.data.url };
  }),
];

const key = (d: Date) => d.getFullYear() * 12 + d.getMonth();
const newest = Math.max(...items.map((i) => key(i.date)));
const oldest = Math.min(...items.map((i) => key(i.date)));
const years = [...new Set(items.map((i) => i.date.getFullYear()))].sort((a, b) => b - a);
const monthsOf = (y: number) => Array.from({ length: 12 }, (_, m) => 11 - m).filter((m) => { const k = y * 12 + m; return k <= newest && k >= oldest; });
const cell = (y: number, m: number, col: number) => items.filter((i) => key(i.date) === y * 12 + m && i.col === col).sort((a, b) => +b.date - +a.date);
const MON = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];
const day = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
const cols = [...subjects.map((s) => s.name), 'Websites'];
const counts = [...subjects.map((s) => `${s.essays.length}`), `${launches.length}`];
---

<Layout title="Lab: timeline — Bhuvan" noindex>
  <Nav />

  <header class="tl-head">
    <h1>I’m Bhuvan. This is everything I’ve written and built since 2021, newest at the top, sorted by what it’s about.</h1>
    <p class="how">One row is a month, so busy months stretch and quiet years stay quiet. The longer the essay, the larger its title.</p>
  </header>

  <div class="tl">
    <div class="cols-head">
      <span class="rail-h"></span>
      {cols.map((c, i) => <span class:list={['ch', { site: i === subjects.length }]}>{c}<b>{counts[i]}</b></span>)}
    </div>

    {years.map((y) => {
      const ms = monthsOf(y);
      return (
        <section class="year" style={`--rows: ${ms.length}`}>
          <div class="rail" style={`grid-row: 1 / span ${ms.length}`}>
            <div class="pin">
              <h2 class="y">{y}</h2>
              <p class="cap">{chapter[y]}</p>
            </div>
          </div>
          {ms.map((m, r) => (
            <>
              <span class="tick" style={`grid-row: ${r + 1}`}>{MON[m]}</span>
              {cols.map((_, c) => {
                const here = cell(y, m, c);
                return here.length > 0 && (
                  <div class="cell" style={`grid-row: ${r + 1}; grid-column: ${c + 3}`}>
                    {here.map((i) => i.kind === 'essay' ? (
                      <a class="ess" href={i.url} style={`--s: ${i.size}`}>
                        <span class="d">{day(i.date)}</span>
                        <span class="t"><span class="hl">{i.title}</span></span>
                      </a>
                    ) : (
                      <a class="site" href={i.url}>
                        <span class="t">{i.title}</span>
                        <span class="u">{i.sub}</span>
                      </a>
                    ))}
                  </div>
                );
              })}
            </>
          ))}
        </section>
      );
    })}
  </div>

  <Footer />
</Layout>

<style>
  .tl-head, .tl { max-width: var(--frame); margin: 0 auto; padding: 0 var(--pad); }
  .tl-head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 3fr); gap: 32px var(--split-gap); align-items: end; padding-top: 12vh; padding-bottom: 8vh; }
  .tl-head h1 { font-family: var(--serif); font-weight: 300; font-size: clamp(1.9rem, 2.8vw, 2.8rem); line-height: 1.2; letter-spacing: -.012em; text-wrap: pretty; }
  .how { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 1.06rem; line-height: 1.5; color: var(--ink-soft); text-wrap: pretty; }

  /* one template for the header and every year, so the columns line up all the way down */
  .cols-head, .year {
    display: grid; column-gap: clamp(18px, 2vw, 32px);
    grid-template-columns: 132px 18px repeat(4, minmax(0, 1fr)) minmax(0, .82fr);
  }
  .cols-head { position: sticky; top: 0; z-index: 3; background: var(--paper); padding: 12px 0 10px; border-bottom: 1px solid var(--rule-strong); }
  .rail-h { grid-column: 1 / span 2; }
  .ch { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 1.05rem; line-height: 1.2; }
  .ch b { margin-left: .5em; font-family: var(--grot); font-style: normal; font-weight: 600; font-size: .64rem; letter-spacing: .1em; color: var(--ink-soft); }
  .ch.site { color: var(--flame); }

  .year { grid-template-rows: repeat(var(--rows), minmax(26px, auto)); border-bottom: 1px solid var(--rule); padding: 14px 0 18px; }
  /* the year rides down the rail while you read through it */
  .rail { grid-column: 1; }
  .pin { position: sticky; top: 64px; }
  .y { font-family: var(--serif); font-weight: 300; font-size: clamp(2.4rem, 3.3vw, 3.3rem); line-height: .9; letter-spacing: -.02em; font-variant-numeric: oldstyle-nums; }
  .cap { margin-top: 12px; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: .98rem; line-height: 1.35; color: var(--flame); text-wrap: pretty; }

  /* a month ruler: one small letter per month, against a hairline */
  .tick { grid-column: 2; align-self: start; padding-top: 7px; border-top: 1px solid var(--rule); font-weight: 600; font-size: .58rem; letter-spacing: .06em; color: var(--ink-faint); text-align: center; }

  .cell { display: grid; align-content: start; gap: 12px; padding: 4px 0 14px; min-width: 0; }
  .ess { display: grid; gap: 3px; }
  .ess .d { font-weight: 600; font-size: .62rem; letter-spacing: .11em; text-transform: uppercase; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .ess .t { font-family: var(--serif); font-size: calc(var(--s) * clamp(.92rem, 1.05vw, 1.05rem)); line-height: 1.16; letter-spacing: calc((var(--s) - 1) * -.02em); text-wrap: balance; hyphens: manual; }
  .ess:hover .hl { background-size: 100% var(--marker-h); }
  .site { display: grid; gap: 1px; padding-left: 10px; border-left: 2px solid var(--flame); }
  .site .t { font-family: var(--serif); font-style: italic; font-size: 1.04rem; line-height: 1.2; color: var(--flame); }
  .site .u { font-weight: 500; font-size: .68rem; color: var(--ink-soft); }
  .site:hover .t { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }

  /* narrow: one column, still in time order; the subject collapses into the column header */
  @media (max-width: 1000px) {
    .tl-head { grid-template-columns: minmax(0, 1fr); padding-top: 6vh; }
    .cols-head { display: none; }
    .year { grid-template-columns: 64px minmax(0, 1fr); grid-template-rows: none; }
    .rail { grid-row: 1 !important; grid-column: 1 / -1; margin-bottom: 14px; }
    .pin { position: static; display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
    .cap { margin-top: 0; }
    .tick { display: none; }
    .cell { grid-row: auto !important; grid-column: 1 / -1 !important; padding: 0; margin-bottom: 14px; }
    .ess .t { font-size: calc(var(--s) * 1rem); }
  }
</style>
