---
// LAB (structure study C): everything on one time line. Each year is a
// chapter: the essays are the text, and what else happened that year (sites
// launched, books, notes) is its margin. Chapter lines and launch months are
// drafts: launch months come from essays and git history, so check them.
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { posts, notes, books, project, thumb, dek, href, smart } from '../../utils/lab';

const chapter: Record<number, string> = {
  2026: 'Back to essays. Also, somehow, seven more websites.',
  2025: 'The year the side projects took over.',
  2024: 'One essay. Mostly I read.',
  2023: 'Banks kept failing, so I kept writing about them.',
  2022: 'Thirteen essays, nearly all of them about markets.',
  2021: 'Hello, world.',
};
// launch months (approximate; to confirm)
const launches: [string, string][] = [
  ['paper-lanterns', '2025-08'], ['rabbit-holes', '2025-08'], ['seneca', '2025-09'],
  ['collections', '2025-11'], ['dumpsterfire', '2025-11'], ['akshara', '2025-12'],
  ['hope-and-despair', '2026-06'], ['smallweb', '2026-06'], ['this-indian', '2026-06'],
  ['measure-of-india', '2026-09'], ['tipsheet', '2026-09'], ['soochi', '2026-10'], ['let-me-walk', '2026-10'],
];
const built = launches.map(([k, m]) => ({ p: project(k), y: +m.slice(0, 4), m: new Date(m + '-01') }));

const years = [...new Set(posts.map((p) => p.data.publishDate.getFullYear()))].sort((a, b) => b - a);
const mon = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short' });
const day = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
---

<Layout title="Lab: almanac — Bhuvan" noindex>
  <Nav />

  <header class="al-head">
    <h1 class="al-statement">I’m Bhuvan. I work at Zerodha on markets, data and curation. This is everything I’ve written, built and read since 2021, in the order it happened.</h1>
    <p class="al-key"><span>Essays</span> in the text. <span>Websites, books and notes</span> in the margin.</p>
  </header>

  <main class="al">
    {years.map((y) => {
      const es = posts.filter((p) => p.data.publishDate.getFullYear() === y);
      const bs = built.filter((b) => b.y === y);
      const ns = notes.filter((n) => n.data.publishDate.getFullYear() === y);
      const rs = books.filter((b) => b.data.year === y);
      return (
        <section class="year" id={`y${y}`}>
          <div class="y-head">
            <h2 class="y-num">{y}</h2>
            <p class="y-line">{chapter[y]}</p>
          </div>

          <ol class="y-essays">
            {es.map((p) => (
              <li><a href={href(p)} class:list={['e', { 'has-img': p.data.image }]}>
                <span class="e-d">{day(p.data.publishDate)}</span>
                <span class="e-body">
                  <span class="e-t"><span class="hl">{smart(p.data.title)}</span></span>
                  {dek(p.data.description) && <span class="e-x">{dek(p.data.description)}</span>}
                </span>
                {p.data.image && <img src={thumb(p.data.image)} alt="" />}
              </a></li>
            ))}
          </ol>

          <div class="y-margin">
            {bs.length > 0 && (
              <div class="m-group">
                <h3>Launched</h3>
                <ul>{bs.map(({ p, m }) => <li><a href={p.data.link}><span class="m-d">{mon(m)}</span><span class="m-t">{smart(p.data.title)}</span><span class="m-x">{smart(p.data.tagline)}</span></a></li>)}</ul>
              </div>
            )}
            {rs.length > 0 && (
              <div class="m-group">
                <h3>Read</h3>
                <ul>{rs.map((b) => <li><a href={`/books/${b.id}/`}><span class="m-t">{b.data.title.split(':')[0]}</span><span class="m-x">{b.data.author}</span></a></li>)}</ul>
              </div>
            )}
            {ns.length > 0 && (
              <div class="m-group">
                <h3>Noted</h3>
                <ul>{ns.map((n) => <li><a href={`/updates/${n.id}/`}><span class="m-d">{mon(n.data.publishDate)}</span><span class="m-t">{smart(n.data.title.trim())}</span></a></li>)}</ul>
              </div>
            )}
          </div>
        </section>
      );
    })}
  </main>

  <Footer />
</Layout>

<style>
  .al-head, .al { max-width: var(--frame); margin: 0 auto; padding: 0 var(--pad); }
  .al-head { padding-top: 13vh; padding-bottom: 8vh; }
  .al-statement { max-width: 24em; font-family: var(--serif); font-weight: 300; font-size: clamp(1.9rem, 2.7vw, 2.7rem); line-height: 1.24; letter-spacing: -.01em; text-wrap: pretty; }
  .al-key { margin-top: 26px; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 1.1rem; color: var(--ink-soft); }
  .al-key span { font-style: normal; font-family: var(--grot); font-weight: 600; font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); }

  .year { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 6.2fr) minmax(0, 2.8fr); gap: 0 clamp(28px, 3.4vw, 52px);
          border-top: 1px solid var(--rule-strong); padding: 26px 0 72px; }
  .y-head { position: sticky; top: 20px; align-self: start; }
  .y-num { font-family: var(--serif); font-weight: 300; font-size: clamp(3rem, 4.6vw, 4.6rem); line-height: .9; letter-spacing: -.02em; font-variant-numeric: oldstyle-nums; }
  .y-line { margin-top: 16px; max-width: 15em; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 1.16rem; line-height: 1.4; color: var(--flame); text-wrap: pretty; }

  .y-essays { list-style: none; }
  .e { display: grid; grid-template-columns: 4.6em minmax(0, 1fr) 92px; gap: 0 20px; align-items: start; padding: 13px 0; border-bottom: 1px solid var(--rule); }
  .y-essays li:first-child .e { padding-top: 4px; }
  .e-d { padding-top: .42em; font-family: var(--grot); font-weight: 600; font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .e-body { display: grid; gap: 4px; grid-column: 2; }
  .e-t { font-family: var(--serif); font-size: 1.24rem; line-height: 1.25; letter-spacing: -.004em; text-wrap: balance; }
  .e-x { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 1rem; line-height: 1.42; color: var(--ink-soft); text-wrap: pretty;
         display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .e img { grid-column: 3; width: 92px; aspect-ratio: 4 / 3; object-fit: cover; }
  .e:hover .hl { background-size: 100% var(--marker-h); }

  .y-margin { padding-left: 20px; border-left: 1px solid var(--rule); align-self: stretch; }
  .m-group + .m-group { margin-top: 30px; }
  .m-group h3 { font-weight: 600; font-size: .68rem; letter-spacing: .13em; text-transform: uppercase; color: var(--flame); margin-bottom: 6px; }
  .m-group ul { list-style: none; }
  .m-group a { display: grid; grid-template-columns: 2.8em minmax(0, 1fr); column-gap: 8px; padding: 6px 0; }
  .m-d { grid-row: span 2; padding-top: .3em; font-weight: 600; font-size: .64rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); }
  .m-t { grid-column: 2; font-family: var(--serif); font-size: 1.02rem; line-height: 1.3; transition: color .2s; }
  .m-x { grid-column: 2; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: .92rem; line-height: 1.35; color: var(--ink-soft); }
  .m-group a:hover .m-t { color: var(--flame); }

  @media (max-width: 1080px) {
    .year { grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr); row-gap: 28px; }
    .y-margin { grid-column: 2; padding-left: 0; border-left: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; }
    .m-group + .m-group { margin-top: 0; }
  }
  @media (max-width: 700px) {
    .al-head { padding-top: 6vh; }
    .year { grid-template-columns: minmax(0, 1fr); }
    .y-head { position: static; display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; }
    .y-line { margin-top: 0; }
    .y-margin { grid-column: 1; }
    .e { grid-template-columns: minmax(0, 1fr) 72px; }
    .e-d { grid-column: 1; padding: 0 0 2px; }
    .e-body { grid-column: 1; }
    .e img { grid-column: 2; grid-row: 1 / span 2; width: 72px; }
  }
</style>
