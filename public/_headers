# Cache and security headers for static files (Cloudflare Workers static assets).

# Hashed build assets: CSS, fonts (content hashes in the file name)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images: a month, revalidated in the background
/blog-images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/note-images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/project-images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/update-images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/book-images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/profile-pic*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/og.jpg
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

# Feeds, sitemaps, llms.txt: short, so new posts show up quickly
/*.xml
  Cache-Control: public, max-age=600, stale-while-revalidate=3600
/*.txt
  Cache-Control: public, max-age=3600

# Everything else, HTML included: revalidate often
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
